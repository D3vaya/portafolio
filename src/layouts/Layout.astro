---
import "@fontsource-variable/anybody/wdth.css"
import "@fontsource-variable/schibsted-grotesk/wght.css"
import anybodyLatin from "@fontsource-variable/anybody/files/anybody-latin-wdth-normal.woff2?url"
import schibstedLatin from "@fontsource-variable/schibsted-grotesk/files/schibsted-grotesk-latin-wght-normal.woff2?url"
import { basics } from "@cv"

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const siteUrl = "https://www.jcayala.dev"
const ogImage = `${siteUrl}${basics.image}`
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ecedef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={siteUrl} />
    <link rel="preload" as="font" type="font/woff2" href={anybodyLatin} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={schibstedLatin} crossorigin />

    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  /*
   * Placa de circuito
   * La página se mide a sí misma en el navegador de quien la visita,
   * dibuja la trayectoria como un flame chart y muestra un harness de
   * agentes funcionando: mensajes que viajan por pistas de cobre.
   */
  :root {
    /* Claro técnico: gris perla, grafito y naranja eléctrico */
    --fondo: #ecedef;
    --hondo: #f8f8f9;
    --papel: #15161a;
    --niebla: #5e626d;
    --senal: #ff5b1f;
    --senal-texto: #c2410c;
    --sobre: #15161a;
    --linea: rgb(21 22 26 / 0.14);
    /* Acción bloqueada por un hook */
    --alto: #e5341d;
    /* Solo para la mascota de Claude Code */
    --claude: #d97757;

    --display: "Anybody Variable", "Arial Narrow", sans-serif;
    --texto: "Schibsted Grotesk Variable", system-ui, sans-serif;

    /* Escala modular 1.333 */
    --t-1: 0.8125rem;
    --t0: 1.0625rem;
    --t1: 1.4rem;
    --t2: 1.875rem;
    --t3: 2.5rem;
    --t4: clamp(2.75rem, 7vw, 4.5rem);
    --t5: clamp(3.5rem, 13.5vw, 11.5rem);

    --gutter: clamp(1rem, 4vw, 3.5rem);
    --max: 82rem;

    color-scheme: light;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--fondo);
    color: var(--papel);
    font-family: var(--texto);
    font-size: 100%;
    line-height: 1.55;
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    background: var(--fondo);
    font-size: var(--t0);
    font-kerning: normal;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  p,
  ul,
  ol,
  dl,
  dd,
  figure {
    margin: 0;
    padding: 0;
  }

  ul,
  ol {
    list-style: none;
  }

  h1,
  h2,
  h3 {
    font-family: var(--display);
    font-weight: 800;
    line-height: 1;
    text-wrap: balance;
  }

  p {
    text-wrap: pretty;
  }

  a {
    color: inherit;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  a:hover {
    text-decoration-color: var(--senal);
    text-decoration-thickness: 2px;
  }

  :focus-visible {
    outline: 3px solid var(--senal);
    outline-offset: 3px;
  }

  ::selection {
    background: var(--senal);
    color: var(--sobre);
  }

  .wrap {
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
