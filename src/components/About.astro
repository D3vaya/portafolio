---
import { basics, languages } from "@cv"

const spoken = languages.map((l) => `${l.language === "Spanish" ? "Español" : l.language === "English" ? "Inglés" : l.language} (${l.fluency.toLowerCase()})`)
---

<section class="wrap about" id="sobre-mi" aria-labelledby="about-title">
  <figure class="portrait">
    <picture>
      <source srcset="/perfil2.webp" type="image/webp" />
      <img src={basics.image} alt={`Retrato de ${basics.name}`} width="800" height="800" loading="lazy" decoding="async" />
    </picture>
  </figure>
  <div class="body">
    <h2 id="about-title">Sobre mí</h2>
    <p>{basics.summary}</p>
    <dl class="facts">
      <div>
        <dt>Base</dt>
        <dd>{basics.location.city}, {basics.location.region}</dd>
      </div>
      <div>
        <dt>Idiomas</dt>
        <dd>{spoken.join(", ")}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .portrait {
    background: var(--fondo);
    aspect-ratio: 1;
    overflow: hidden;
    border-bottom: 6px solid var(--senal);
  }

  .portrait picture {
    display: contents;
  }

  .portrait img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.15) brightness(1.05);
    mix-blend-mode: luminosity;
  }

  h2 {
    font-size: var(--t4);
    font-stretch: 78%;
  }

  .body p {
    max-width: 36em;
    margin-top: 1.5rem;
    font-size: var(--t1);
    line-height: 1.45;
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--linea);
  }

  .facts dt {
    color: var(--niebla);
    font-size: var(--t-1);
  }

  .facts dd {
    margin-top: 0.25rem;
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }

    .portrait {
      max-width: 22rem;
    }

    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
