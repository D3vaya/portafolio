---
import { certificates, skills, work } from "@cv"
import { CONTEXT_WINDOW, buildPrompts } from "@/data/harness"
import Perfil from "@/components/respuestas/Perfil.astro"
import Trayectoria from "@/components/respuestas/Trayectoria.astro"
import Productos from "@/components/respuestas/Productos.astro"
import Stack from "@/components/respuestas/Stack.astro"
import Aprendizaje from "@/components/respuestas/Aprendizaje.astro"
import Contacto from "@/components/respuestas/Contacto.astro"

const counts = { work: work.length, skills: skills.length, certificates: certificates.length }
const prompts = buildPrompts(counts)
const bodies: Record<string, (props: Record<string, never>) => unknown> = {
  perfil: Perfil,
  trayectoria: Trayectoria,
  productos: Productos,
  stack: Stack,
  aprendizaje: Aprendizaje,
  contacto: Contacto,
}
const windowK = `${CONTEXT_WINDOW / 1000}k`
---

<section class="harness" id="harness" aria-labelledby="harness-title" data-counts={JSON.stringify(counts)}>
  <div class="term wrap" data-term>
    <div class="board-pane js-only" data-run>
      <div class="board" data-board>
        <dl class="hud" aria-label="Contadores de la simulación">
          <div><dt>Tokens en contexto</dt><dd data-hud="tokens">0</dd></div>
          <div><dt>Desde caché</dt><dd data-hud="cached">0</dd></div>
          <div><dt>Herramientas usadas</dt><dd data-hud="tools">0</dd></div>
          <div><dt>Bloqueos</dt><dd data-hud="blocked">0</dd></div>
        </dl>
        <div class="canvas" data-canvas aria-hidden="true"></div>
        <div class="gauge" aria-hidden="true">
          <p class="gauge-head">
            <span class="gauge-title">Ventana de contexto <span class="gauge-tag">simulación</span></span>
            <span class="gauge-total" data-gauge-total>0 de {windowK} tokens</span>
          </p>
          <div class="gauge-track">
            <div class="gauge-bar" data-gauge-bar></div>
            <span class="gauge-cache" data-gauge-cache><span>en caché</span></span>
          </div>
          <ul class="gauge-legend" data-gauge-legend></ul>
        </div>
      </div>

      <div class="below">
        <div class="caption">
          <p class="caption-meta">
            <span data-step-count>En espera</span>
            <span class="caption-layer" data-step-layer></span>
          </p>
          <p class="caption-title" data-step-title>El harness está listo</p>
          <p class="caption-text" data-step-text>Cuando llegue una pregunta vas a ver cada paso en la placa.</p>
        </div>
        <div class="controls">
          <button class="toggle" type="button" data-toggle aria-pressed="false">Pausar</button>
          <ol class="steps" aria-label="Pasos de la corrida" data-steps></ol>
        </div>
      </div>
    </div>

    <div class="console">
      <p class="titlebar js-only" aria-hidden="true">
        <span class="lights"><i></i><i></i><i></i></span>
        <span>jcayala — harness</span>
      </p>

      <div class="transcript" data-transcript>
        <header class="motd">
          <h2 id="harness-title">Pregúntale a mi harness</h2>
          <p class="problem">
            Este CV corre sobre un harness. Elige una pregunta y mira cómo se arma la respuesta. Es una simulación con
            mi contenido real.
          </p>
        </header>
        <p class="visually-hidden" aria-live="polite" data-announce></p>
        {
          prompts.map((p) => {
            const Body = bodies[p.id]
            return (
              <article class="qa" id={p.anchor} data-qa={p.id} aria-labelledby={`q-${p.id}`}>
                <h3 class="qa-q" id={`q-${p.id}`}>
                  {p.label}
                </h3>
                <p class="qa-status js-only" data-qa-status />
                <div class="qa-a" data-qa-body>
                  <Body />
                </div>
              </article>
            )
          })
        }
        <div class="thinking js-only" data-thinking hidden>
          <p class="think-line">
            <span class="think-dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span data-think-text>Pensando…</span>
          </p>
          <p class="think-sub" data-think-sub></p>
          <div class="think-bar" aria-hidden="true"><span data-think-bar></span></div>
          <button type="button" class="skip" data-skip>Ver respuesta ya <kbd>Esc</kbd></button>
        </div>
      </div>

      <div class="input js-only">
        <p class="input-label" id="ask-label">Elige una pregunta</p>
        <ul class="chips" aria-labelledby="ask-label" data-chips>
          {
            prompts.map((p) => (
              <li>
                <button type="button" class="chip" data-ask={p.id} aria-controls={p.anchor}>
                  {p.label}
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { buildPrompts, fmt, layers, planRun, CONTEXT_WINDOW, type Counts, type Prompt, type Step } from "@/data/harness"
  import { commit, fold, isToolCall, newSession, totals, type Session } from "@/lib/contexto"

  const layerName: Record<string, string> = Object.fromEntries(layers.map((l) => [l.id, l.name]))
  const section = document.querySelector<HTMLElement>("#harness")!
  const prompts = buildPrompts(JSON.parse(section.dataset.counts!) as Counts)

  const NS = "http://www.w3.org/2000/svg"
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches
  const compact = matchMedia("(max-width: 40rem)")
  const TRAVEL = 1150
  // Ritmo de la simulación: acelera todo el reloj (paquetes, globo, barra y pasos)
  // para que una respuesta llegue en unos 6 s; los botones de pasos permiten revisarlos con calma
  const SPEED = 2.8
  // Cuánto queda a la vista un paquete al llegar, y el mínimo de un paso, en tiempo de simulación
  const HOLD = 500
  const MIN_STEP = 1800

  // ---------- Diagrama: nodos y pistas, en ancho y en una versión compacta para móvil ----------
  type Pos = { x: number; y: number }
  type Mode = "wide" | "mini"
  const nodes: Record<string, { title: string; sub: string; wide: Pos; mini: Pos }> = {
    usuario: { title: "Tú", sub: "eliges la pregunta", wide: { x: 130, y: 90 }, mini: { x: 60, y: 36 } },
    modelo: { title: "Modelo", sub: "razona y propone", wide: { x: 500, y: 70 }, mini: { x: 200, y: 36 } },
    memoria: { title: "Memoria", sub: "CLAUDE.md y notas", wide: { x: 130, y: 320 }, mini: { x: 60, y: 150 } },
    cache: { title: "Caché de prompt", sub: "inicio repetido", wide: { x: 870, y: 320 }, mini: { x: 340, y: 36 } },
    core: { title: "Claude Code", sub: "el harness", wide: { x: 500, y: 320 }, mini: { x: 200, y: 150 } },
    skills: { title: "Skills", sub: "una por tema", wide: { x: 130, y: 550 }, mini: { x: 60, y: 266 } },
    herramientas: { title: "Herramientas", sub: "leer_cv, publicar", wide: { x: 500, y: 600 }, mini: { x: 200, y: 266 } },
    navegador: { title: "Navegador", sub: "servidor MCP", wide: { x: 870, y: 600 }, mini: { x: 340, y: 266 } },
  }

  // Cada pista va de centro a centro pasando por `via`, siempre en ángulo recto.
  // Los tramos que caen dentro de un chip quedan tapados por él.
  const edges: { a: string; b: string; wide: Pos[]; mini: Pos[]; hook?: boolean }[] = [
    { a: "usuario", b: "core", wide: [{ x: 300, y: 90 }, { x: 300, y: 270 }, { x: 500, y: 270 }], mini: [{ x: 60, y: 92 }, { x: 150, y: 92 }, { x: 150, y: 150 }] },
    { a: "modelo", b: "core", wide: [], mini: [] },
    { a: "memoria", b: "core", wide: [], mini: [] },
    { a: "skills", b: "core", wide: [{ x: 300, y: 550 }, { x: 300, y: 370 }, { x: 500, y: 370 }], mini: [{ x: 60, y: 210 }, { x: 150, y: 210 }, { x: 150, y: 150 }] },
    { a: "cache", b: "core", wide: [], mini: [{ x: 340, y: 92 }, { x: 250, y: 92 }, { x: 250, y: 150 }] },
    { a: "core", b: "herramientas", wide: [], mini: [], hook: true },
    { a: "herramientas", b: "navegador", wide: [], mini: [] },
  ]

  // hook: dónde va la insignia y dónde se detiene lo bloqueado, como fracción de la pista
  const layout = {
    wide: { w: 1000, h: 660, node: { w: 180, h: 70 }, core: { w: 230, h: 220 }, font: 21, packet: 18, bubble: 19, badge: 1.1, hook: { at: 0.73, stop: 0.54 } },
    mini: { w: 400, h: 292, node: { w: 104, h: 46 }, core: { w: 136, h: 82 }, font: 12.5, packet: 11.5, bubble: 11.5, badge: 0.78, hook: { at: 0.7, stop: 0.47 } },
  }

  const el = (tag: string, attrs: Record<string, string | number> = {}, parent?: Element) => {
    const node = document.createElementNS(NS, tag) as SVGGraphicsElement
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v))
    parent?.appendChild(node)
    return node
  }

  const routePath = (p: Pos, via: Pos[], q: Pos) => [p, ...via, q].map((v, i) => `${i ? "L" : "M"}${v.x} ${v.y}`).join(" ")

  // Mascota de Claude Code dibujada desde su arte de terminal:
  //  ▐▛███▜▌
  // ▝▜█████▛▘
  //   ▘▘ ▝▝
  // Cada carácter son 2×2 cuadrantes; cada cuadrante mide 1 de ancho por 2 de alto.
  const BODY = [
    "...############...",
    "...##.######.##...",
    "..###############.",
    ".#.############...",
  ]
  const mascot = (parent: Element, size: number) => {
    const g = el("g", { class: "mascot", "shape-rendering": "crispEdges" }, parent)
    const u = size / 18
    const px = (x: number, y: number, cls: string) =>
      el("rect", { class: cls, x: x * u, y: y * u * 2, width: u + 0.6, height: u * 2 + 0.6 }, g)
    BODY.forEach((row, y) => [...row].forEach((c, x) => c === "#" && px(x, y, "body")))
    px(5, 1, "eye")
    px(12, 1, "eye")
    px(4, 4, "leg leg-a")
    px(6, 4, "leg leg-b")
    px(11, 4.5, "leg leg-a")
    px(13, 4.5, "leg leg-b")
    return g
  }

  type Built = {
    svg: SVGSVGElement
    mode: Mode
    nodeEls: Record<string, Element>
    paths: Map<string, SVGPathElement>
    signals: Map<string, SVGPathElement>
    packets: Element
    bubble: { g: Element; rect: Element; text: SVGTextElement }
  }

  const canvas = document.querySelector<HTMLElement>("[data-canvas]")!
  const board = document.querySelector<HTMLElement>("[data-board]")!
  let built: Built

  const build = (): Built => {
    const mode: Mode = compact.matches ? "mini" : "wide"
    const L = layout[mode]
    canvas.replaceChildren()
    const svg = el("svg", { viewBox: `0 0 ${L.w} ${L.h}`, class: "board-svg" }) as SVGSVGElement
    svg.style.setProperty("--font", `${L.font}px`)
    svg.style.setProperty("--packet", `${L.packet}px`)
    svg.style.setProperty("--bubble", `${L.bubble}px`)
    canvas.appendChild(svg)

    const tracesG = el("g", {}, svg)
    const paths = new Map<string, SVGPathElement>()
    const signals = new Map<string, SVGPathElement>()
    const pos = (id: string) => nodes[id][mode]

    edges.forEach((e, i) => {
      const d = routePath(pos(e.a), e[mode], pos(e.b))
      const key = `${e.a}>${e.b}`
      const trace = el("path", { d, class: "trace" }, tracesG) as SVGPathElement
      const len = trace.getTotalLength()
      trace.style.setProperty("--len", String(len))
      trace.style.setProperty("--d", `${i * 90}ms`)
      paths.set(key, trace)
      signals.set(key, el("path", { d, class: "trace-signal" }, tracesG) as SVGPathElement)
      if (e.hook) {
        const mid = trace.getPointAtLength(len * L.hook.at)
        const hook = el("g", { transform: `translate(${mid.x} ${mid.y}) scale(${L.badge})` }, tracesG)
        const body = el("g", { class: "hook" }, hook)
        el("rect", { x: -30, y: -13, width: 60, height: 26, rx: 13 }, body)
        el("text", { y: 5, "text-anchor": "middle" }, body).textContent = "hook"
      }
    })

    const nodesG = el("g", {}, svg)
    const nodeEls: Record<string, Element> = {}
    Object.entries(nodes).forEach(([id, n], i) => {
      const p = pos(id)
      const isCore = id === "core"
      const size = isCore ? L.core : L.node
      const outer = el("g", { transform: `translate(${p.x} ${p.y})` }, nodesG)
      const g = el("g", { class: `node${isCore ? " is-core" : ""}` }, outer)
      g.style.setProperty("--d", `${300 + i * 70}ms`)
      el("rect", { class: "chip", x: -size.w / 2, y: -size.h / 2, width: size.w, height: size.h, rx: 8 }, g)
      for (const side of [-1, 1]) {
        for (let k = 1; k <= 3; k++) {
          const y = -size.h / 2 + (size.h / 4) * k
          el("rect", { class: "pin", x: side > 0 ? size.w / 2 : -size.w / 2 - 6, y: y - 2, width: 6, height: 4 }, g)
        }
      }
      if (isCore && mode === "wide") {
        const holder = el("g", { transform: `translate(${-size.w * 0.3} ${-size.h * 0.4})` }, g)
        mascot(holder, size.w * 0.6)
        el("text", { class: "node-title", y: size.h * 0.25, "text-anchor": "middle" }, g).textContent = n.title
        el("text", { class: "node-sub", y: size.h * 0.25 + L.font * 1.2, "text-anchor": "middle" }, g).textContent = n.sub
      } else if (isCore) {
        // En la versión compacta la mascota va arriba y el globo sale hacia la derecha
        const holder = el("g", { transform: `translate(-26 ${-size.h / 2 + 7})` }, g)
        mascot(holder, 52)
        el("text", { class: "node-title", y: size.h * 0.26, "text-anchor": "middle" }, g).textContent = n.title
        el("text", { class: "node-sub", y: size.h * 0.26 + L.font * 1.1, "text-anchor": "middle" }, g).textContent = n.sub
      } else {
        el("text", { class: "node-title", y: -2, "text-anchor": "middle" }, g).textContent = n.title
        el("text", { class: "node-sub", y: L.font * 1.05, "text-anchor": "middle" }, g).textContent = n.sub
      }
      nodeEls[id] = g
    })

    // Globo de diálogo de la mascota
    const core = pos("core")
    const b = L.bubble
    const at = mode === "wide" ? { x: core.x + L.core.w * 0.12, y: core.y - L.core.h / 2 - b * 1.9 } : { x: core.x + L.core.w / 2 + 12, y: core.y }
    const bubbleG = el("g", { transform: `translate(${at.x} ${at.y})` }, svg)
    const bubble = el("g", { class: `bubble is-${mode}` }, bubbleG)
    const rect = el("rect", { x: 0, y: -b * 1.05, height: b * 2.1, rx: b * 1.05 }, bubble)
    const tail = mode === "wide" ? `M${b * 0.8} ${b * 0.9} l${-b * 0.5} ${b * 0.9} l${b * 1.1} ${-b * 0.9}z` : `M${b * 0.5} ${-b * 0.5} l${-b * 1.1} ${b * 0.5} l${b * 1.1} ${b * 0.5}z`
    el("path", { class: "bubble-tail", d: tail }, bubble)
    const text = el("text", { x: b * 0.9, y: b * 0.36 }, bubble) as SVGTextElement

    return { svg, mode, nodeEls, paths, signals, packets: el("g", {}, svg), bubble: { g: bubble, rect, text } }
  }


  // ---------- Ventana de contexto ----------
  const gauge = {
    bar: document.querySelector<HTMLElement>("[data-gauge-bar]")!,
    cache: document.querySelector<HTMLElement>("[data-gauge-cache]")!,
    legend: document.querySelector<HTMLElement>("[data-gauge-legend]")!,
    total: document.querySelector<HTMLElement>("[data-gauge-total]")!,
  }
  const segEls = new Map<string, HTMLElement>()
  let gaugeKey = ""

  const hud = Object.fromEntries(
    [...document.querySelectorAll<HTMLElement>("[data-hud]")].map((d) => [d.dataset.hud!, d]),
  ) as Record<"tokens" | "cached" | "tools" | "blocked", HTMLElement>

  const renderContext = (ctx: ReturnType<typeof fold>) => {
    hud.tokens.textContent = fmt(ctx.total)
    hud.cached.textContent = fmt(ctx.cacheRead)
    const key = ctx.segs.map((s) => `${s.id}:${s.tokens}:${s.cached ? 1 : 0}`).join()
    if (key === gaugeKey) return
    gaugeKey = key
    const pct = (n: number) => `${(n / CONTEXT_WINDOW) * 100}%`
    const ids = new Set(ctx.segs.map((s) => s.id))
    // Los tramos que salen se encogen antes de desaparecer
    for (const [id, node] of segEls) {
      if (ids.has(id)) continue
      segEls.delete(id)
      node.style.width = "0%"
      setTimeout(() => node.remove(), reduceMotion ? 0 : 700)
    }
    ctx.segs.forEach((s, i) => {
      let node = segEls.get(s.id)
      if (!node) {
        node = document.createElement("span")
        node.className = "seg"
        node.dataset.seg = s.id
        node.style.width = "0%"
        segEls.set(s.id, node)
      }
      // El orden de la barra sigue al de la ventana: lo fijo, la historia y la pregunta en curso
      const at = gauge.bar.children[i]
      if (at !== node) gauge.bar.insertBefore(node, at ?? null)
      void node.offsetWidth
      node.style.width = pct(s.tokens)
      node.classList.toggle("is-cached", Boolean(s.cached))
    })
    gauge.cache.style.width = pct(ctx.cachedSum)
    gauge.cache.classList.toggle("is-on", ctx.cachedSum > 0)
    gauge.total.classList.toggle("is-full", ctx.total / CONTEXT_WINDOW >= 0.8)
    gauge.total.textContent = `${fmt(ctx.total)} de ${fmt(CONTEXT_WINDOW)} tokens · ${Math.round((ctx.total / CONTEXT_WINDOW) * 100)} %`
    gauge.legend.replaceChildren(
      ...ctx.segs.map((s) => {
        const li = document.createElement("li")
        li.dataset.seg = s.id
        li.classList.toggle("is-cached", Boolean(s.cached))
        const b = document.createElement("b")
        b.textContent = fmt(s.tokens)
        li.append(document.createElement("i"), `${s.label} `, b)
        return li
      }),
    )
  }

  // ---------- Corrida de una pregunta ----------
  type Run = {
    prompt: Prompt
    steps: Step[]
    base: Session
    done: boolean
    revealed: boolean
    byUser: boolean
  }
  let session = newSession()
  let run: Run | null = null

  const stepDuration = (s: Step) => {
    const c = s.context
    return Math.max(
      MIN_STEP,
      ...s.messages.map((m) => (m.delay ?? 0) + TRAVEL + (m.blocked ? 1400 : HOLD)),
      ...(c?.add ?? []).map((a) => (a.delay ?? 0) + HOLD),
      c?.cache ? c.cache.delay + HOLD : 0,
      c?.compact ? c.compact.delay + 1200 : 0,
    )
  }

  type Live = { packet: Element; label: SVGTextElement; path: SVGPathElement; signal: SVGPathElement; reverse: boolean; arrived: boolean; counted: boolean }
  let index = 0
  let elapsed = 0
  let last = 0
  let atEnd = false
  let userPaused = false
  let visible = false
  let booted = reduceMotion
  let live: Live[] = []
  const counts = { tools: 0, blocked: 0 }

  const renderHud = () => {
    hud.tools.textContent = String(counts.tools)
    hud.blocked.textContent = String(counts.blocked)
  }

  // Contadores de la sesión más los pasos ya completos de esta corrida
  const countBefore = (r: Run, i: number) => {
    counts.tools = r.base.tools
    counts.blocked = r.base.blocked
    for (const m of r.steps.slice(0, i).flatMap((s) => s.messages)) {
      if (m.blocked) counts.blocked++
      if (isToolCall(m)) counts.tools++
    }
  }

  const findPath = (from: string, to: string) => {
    const key = built.paths.has(`${from}>${to}`) ? `${from}>${to}` : `${to}>${from}`
    return { path: built.paths.get(key)!, signal: built.signals.get(key)!, reverse: key !== `${from}>${to}` }
  }

  const sizeRect = (rect: Element, label: SVGTextElement, pad: number) => {
    const w = label.getComputedTextLength() + pad
    rect.setAttribute("x", String(-w / 2))
    rect.setAttribute("width", String(w))
  }

  const makePacket = (text: string) => {
    const f = layout[built.mode].packet
    const g = el("g", { class: "packet" }, built.packets)
    const rect = el("rect", { rx: f, y: -f, height: f * 2 }, g)
    const label = el("text", { "text-anchor": "middle", y: f * 0.35 }, g) as SVGTextElement
    label.textContent = text
    sizeRect(rect, label, f * 1.5)
    return { packet: g, label }
  }

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!
  const caption = {
    count: $("[data-step-count]"),
    layer: $("[data-step-layer]"),
    title: $("[data-step-title]"),
    text: $("[data-step-text]"),
  }
  const term = $("[data-term]")
  const transcript = $("[data-transcript]")
  const thinking = $("[data-thinking]")
  const think = { text: $("[data-think-text]"), sub: $("[data-think-sub]"), bar: $("[data-think-bar]") }
  const stepList = $<HTMLOListElement>("[data-steps]")
  const announcer = $("[data-announce]")
  const toggle = $<HTMLButtonElement>("[data-toggle]")
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-chips] [data-ask]")]
  const qa = (id: string) => $(`[data-qa="${id}"]`)
  let stepButtons: HTMLButtonElement[] = []
  let sayFull = ""

  // Mientras una pregunta propia se responde, las demás esperan
  const setBusy = (busy: boolean) => {
    term.classList.toggle("is-busy", busy)
    for (const c of chips) c.setAttribute("aria-disabled", String(busy))
  }

  const follow = (top: number) =>
    transcript.scrollTo({ top, behavior: reduceMotion ? "auto" : "smooth" })

  const renderStepList = (r: Run) => {
    stepList.style.setProperty("--n", String(r.steps.length))
    stepButtons = r.steps.map((s, k) => {
      const b = document.createElement("button")
      b.type = "button"
      b.dataset.step = String(k)
      b.setAttribute("aria-label", `Paso ${k + 1}: ${s.title}`)
      const bar = document.createElement("span")
      bar.className = "steps-bar"
      const title = document.createElement("span")
      title.className = "steps-title"
      title.textContent = s.title
      b.append(bar, title)
      return b
    })
    stepList.replaceChildren(
      ...stepButtons.map((b) => {
        const li = document.createElement("li")
        li.append(b)
        return li
      }),
    )
  }

  const enter = (i: number) => {
    if (!run) return
    const r = run
    index = Math.max(0, Math.min(i, r.steps.length - 1))
    elapsed = 0
    atEnd = false
    const s = r.steps[index]
    countBefore(r, index)
    // Sin animación el paso se muestra ya completo
    if (reduceMotion) {
      for (const m of s.messages) {
        if (m.blocked) counts.blocked++
        if (isToolCall(m)) counts.tools++
      }
    }
    renderHud()
    built.packets.replaceChildren()
    for (const signal of built.signals.values()) signal.classList.remove("is-on")
    live = s.messages.map((m) => ({ ...makePacket(m.label), ...findPath(m.from, m.to), arrived: false, counted: false }))
    for (const [id, g] of Object.entries(built.nodeEls)) {
      g.classList.toggle("is-active", s.active.includes(id))
      g.classList.remove("is-pulse", "is-alarmed")
    }
    built.nodeEls.core.classList.toggle("is-thinking", s.layer === "modelo")

    // El globo se dimensiona con el texto completo y luego se escribe letra a letra
    sayFull = s.say
    const { rect, text, g } = built.bubble
    text.textContent = sayFull
    const w = text.getComputedTextLength() + Number(text.getAttribute("x")) * 2
    rect.setAttribute("width", String(w))
    text.textContent = reduceMotion ? sayFull : ""
    g.classList.remove("is-in")
    void g.getBoundingClientRect()
    g.classList.add("is-in")

    caption.count.textContent = `Paso ${index + 1} de ${r.steps.length}`
    caption.layer.textContent = s.layer ? `Capa: ${layerName[s.layer]}` : ""
    caption.title.textContent = s.title
    caption.text.textContent = s.text
    if (!r.revealed) {
      think.text.textContent = `Paso ${index + 1} de ${r.steps.length} · ${s.title}`
      think.sub.textContent = s.text
    }
    stepButtons.forEach((b, k) => {
      if (k === index) b.setAttribute("aria-current", "step")
      else b.removeAttribute("aria-current")
      b.classList.toggle("is-done", k < index)
      b.style.setProperty("--p", "0")
    })
    draw()
  }

  const draw = () => {
    if (!run) return
    const r = run
    const s = r.steps[index]
    const stop = layout[built.mode].hook.stop
    let busy = false
    s.messages.forEach((m, k) => {
      const item = live[k]
      // Con movimiento reducido cada mensaje queda quieto a mitad de camino, y lo bloqueado, en el hook
      const raw = reduceMotion ? (m.blocked ? stop : 0.5) : (elapsed - (m.delay ?? 0)) / TRAVEL
      const t = Math.min(Math.max(raw, 0), m.blocked ? stop : 1)
      const len = item.path.getTotalLength()
      const at = item.path.getPointAtLength(len * (item.reverse ? 1 - t : t))
      const moving = raw >= 0 && raw <= 1
      const blocked = Boolean(m.blocked) && raw >= stop
      item.packet.setAttribute("transform", `translate(${at.x} ${at.y})`)
      item.packet.classList.toggle("is-visible", reduceMotion || moving || blocked)
      if (blocked && !item.packet.classList.contains("is-blocked")) {
        item.packet.classList.add("is-blocked")
        item.label.textContent = m.blocked!
        sizeRect(item.packet.querySelector("rect")!, item.label, layout[built.mode].packet * 1.5)
        built.nodeEls[m.from].classList.add("is-alarmed")
      }
      item.signal.classList.toggle("is-on", moving && !blocked)
      if (moving && (m.from === "core" || m.to === "core")) busy = true
      if (!item.counted && !reduceMotion && (raw >= 1 || blocked)) {
        item.counted = true
        if (m.blocked) counts.blocked++
        if (isToolCall(m)) counts.tools++
        renderHud()
      }
      if (!item.arrived && raw >= 1 && !m.blocked) {
        item.arrived = true
        const target = built.nodeEls[m.to]
        target.classList.remove("is-pulse")
        void target.getBoundingClientRect()
        target.classList.add("is-pulse")
        if (s.reveal && m.to === "usuario") reveal(r)
      }
    })
    if (reduceMotion && s.reveal) reveal(r)
    renderContext(fold(r.base, r.steps, index, reduceMotion ? Infinity : elapsed))
    built.nodeEls.core.classList.toggle("is-busy", busy)
    if (!reduceMotion) built.bubble.text.textContent = sayFull.slice(0, Math.floor(elapsed / 38))
    const dur = stepDuration(s)
    stepButtons[index]?.style.setProperty("--p", String(Math.min(1, elapsed / dur)))
    // Avance de toda la corrida para la barra de la consola
    if (!r.revealed) {
      const all = r.steps.map(stepDuration)
      const done = all.slice(0, index).reduce((n, d) => n + d, 0) + Math.min(elapsed, dur)
      think.bar.style.transform = `scaleX(${done / all.reduce((n, d) => n + d, 0)})`
    }
  }

  // ---------- Bloqueo de scroll mientras responde ----------
  // La página no se mueve; la conversación sí puede desplazarse por dentro
  let locked = false
  let unlockTimer = 0
  const insideTranscript = (e: Event) => transcript.contains(e.target as Node)
  const stopScroll = (e: Event) => {
    if (!insideTranscript(e)) e.preventDefault()
  }
  const lock = () => {
    if (locked) return
    locked = true
    const html = document.documentElement
    const gap = innerWidth - html.clientWidth
    html.style.overflow = "hidden"
    if (gap > 0) html.style.paddingRight = `${gap}px`
    addEventListener("wheel", stopScroll, { passive: false })
    addEventListener("touchmove", stopScroll, { passive: false })
  }
  const unlock = () => {
    clearTimeout(unlockTimer)
    if (!locked) return
    locked = false
    const html = document.documentElement
    html.style.overflow = ""
    html.style.paddingRight = ""
    removeEventListener("wheel", stopScroll)
    removeEventListener("touchmove", stopScroll)
  }

  // Solo se bloquea con la terminal entera a la vista
  const fullyInView = () => {
    const r = section.getBoundingClientRect()
    return Math.abs(r.top) <= 2 && r.bottom <= innerHeight + 2
  }

  // Lleva la terminal a la vista: su borde superior con el de la ventana
  const bringIntoView = () =>
    new Promise<void>((resolve) => {
      const top = section.getBoundingClientRect().top
      if (Math.abs(top) <= 2) return resolve()
      let done = false
      const finish = () => {
        if (done) return
        done = true
        removeEventListener("scrollend", finish)
        // Si algo arriba cambió de alto durante el viaje, se corrige el último tramo
        const off = section.getBoundingClientRect().top
        if (Math.abs(off) > 2) scrollTo({ top: scrollY + off, behavior: "instant" })
        resolve()
      }
      addEventListener("scrollend", finish)
      setTimeout(finish, 1100)
      scrollTo({ top: scrollY + top, behavior: reduceMotion ? "auto" : "smooth" })
    })

  // ---------- Respuesta en la consola ----------
  const reveal = (r: Run) => {
    if (r.revealed) return
    r.revealed = true
    const article = qa(r.prompt.id)
    const body = $("[data-qa-body]", article)
    const blocks = body.querySelectorAll<HTMLElement>(":scope > .resp > *")
    blocks.forEach((c, i) => c.style.setProperty("--i", String(i)))
    thinking.hidden = true
    body.classList.add("is-in")
    announcer.textContent = `Respuesta lista: ${r.prompt.label}`
    // La sesión queda al día aunque la placa siga terminando su último paso
    finishRun(r)
    setBusy(false)
    follow(article.offsetTop - 12)
    // La página se libera cuando la respuesta terminó de aparecer
    unlockTimer = window.setTimeout(unlock, reduceMotion ? 0 : 150 + blocks.length * 110 + 600)
  }

  const finishRun = (r: Run) => {
    if (r.done) return
    session = commit(r.base, r.steps, { id: r.prompt.skill, tokens: r.prompt.skillTokens })
    r.done = true
    reveal(r)
    $("[data-qa-status]", qa(r.prompt.id)).textContent = `Respondida en ${r.steps.length} pasos · skill «${r.prompt.skill}» · simulación`
  }

  // Termina la corrida en el acto: la placa salta al último paso con todo contado
  const skip = () => {
    const r = run
    if (!r || r.revealed) return
    enter(r.steps.length - 1)
    elapsed = stepDuration(r.steps[index])
    draw()
    stepButtons[index]?.classList.add("is-done")
    atEnd = true
    finishRun(r)
    unlock()
  }

  const startRun = (p: Prompt, byUser: boolean) => {
    ensureBuilt()
    // Una pregunta nueva cierra la anterior de inmediato
    if (run && !run.revealed) skip()
    const base = session
    const steps = planRun(p, prompts.length, { ...totals(base.segs), cacheWritten: base.cacheWritten })
    run = { prompt: p, steps, base, done: false, revealed: false, byUser }

    // Lo más reciente va abajo, como en una terminal
    const article = qa(p.id)
    $("[data-qa-body]", article).classList.remove("is-in")
    $("[data-qa-status]", article).textContent = ""
    transcript.insertBefore(article, thinking)
    article.classList.add("is-asked")
    thinking.hidden = false
    think.bar.style.transform = "scaleX(0)"
    announcer.textContent = `Preguntaste: ${p.label}`
    for (const c of chips) c.setAttribute("aria-pressed", String(c.dataset.ask === p.id))
    if (byUser) setBusy(true)
    follow(transcript.scrollHeight)

    renderStepList(run)
    booted = true
    board.classList.add("is-booted")
    if (reduceMotion) {
      enter(steps.length - 1)
      finishRun(run)
    } else enter(0)
    kick()
  }

  // El bucle solo corre mientras la animación avanza; se reactiva con kick()
  let raf = 0
  const running = () => !userPaused && visible && booted && Boolean(run) && !atEnd && !reduceMotion
  const loop = (now: number) => {
    if (!running()) {
      raf = 0
      last = 0
      return
    }
    const dt = last ? Math.min(now - last, 100) : 0
    last = now
    elapsed += dt * SPEED
    const r = run!
    if (elapsed >= stepDuration(r.steps[index])) {
      if (index < r.steps.length - 1) enter(index + 1)
      else {
        // Al final la placa queda quieta en el último paso
        draw()
        stepButtons[index]?.classList.add("is-done")
        atEnd = true
        finishRun(r)
      }
    } else draw()
    raf = requestAnimationFrame(loop)
  }
  const kick = () => {
    if (!raf && running()) raf = requestAnimationFrame(loop)
  }

  // ---------- Controles ----------
  const setPaused = (p: boolean) => {
    userPaused = p
    toggle.textContent = p ? "Reproducir" : "Pausar"
    toggle.setAttribute("aria-pressed", String(p))
    kick()
  }
  toggle.addEventListener("click", () => setPaused(!userPaused))
  $("[data-skip]").addEventListener("click", skip)
  addEventListener("keydown", (e) => {
    if (e.key === "Escape" && run && !run.revealed) skip()
  })

  stepList.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("[data-step]")
    if (!b || !run || !run.revealed) return
    enter(Number(b.dataset.step))
    kick()
  })

  // Preguntar desde un chip, el menú o un enlace: la terminal se pone a la vista,
  // responde y la página espera quieta hasta que la respuesta aparece
  const ask = async (p: Prompt) => {
    if (run && run.byUser && !run.revealed) return
    started = true
    startRun(p, true)
    if (reduceMotion) return bringIntoView()
    await bringIntoView()
    if (run && run.prompt === p && !run.revealed && fullyInView()) lock()
  }

  term.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("[data-ask]")
    if (!b || b.getAttribute("aria-disabled") === "true") return
    ask(prompts.find((p) => p.id === b.dataset.ask)!)
  })

  const fromHash = (hash: string) => prompts.find((p) => `#${p.anchor}` === hash)
  document.addEventListener("click", (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]')
    const p = a && fromHash(a.hash)
    if (!p) return
    e.preventDefault()
    history.pushState(null, "", `#${p.anchor}`)
    ask(p)
  })
  // Atrás, adelante o un ancla escrita a mano: se espera un cuadro para que el salto
  // del navegador al ancla no gane
  const onHash = () => {
    requestAnimationFrame(() => {
      const p = fromHash(location.hash)
      if (p && !(run && run.prompt === p && !run.revealed)) ask(p)
    })
  }
  addEventListener("popstate", onHash)
  addEventListener("hashchange", onHash)

  // El diagrama se construye recién cuando la sección se acerca a la pantalla:
  // medir el SVG al cargar la página retrasaba el primer pintado
  let isBuilt = false
  const ensureBuilt = () => {
    if (isBuilt) return
    isBuilt = true
    built = build()
  }

  new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) ensureBuilt()
    },
    { rootMargin: "100% 0px" },
  ).observe(term)

  // La placa se anima solo mientras se ve
  new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting
      if (visible) board.classList.add("is-booted")
      kick()
    },
    { threshold: 0.25 },
  ).observe(board)

  // La primera vez que la terminal llena casi toda la pantalla responde sola
  // «¿Quién es Juan Carlos?», sin bloquear nada: quien va de paso sigue de largo
  let started = false
  new IntersectionObserver(
    ([entry]) => {
      if (!entry.isIntersecting || started) return
      started = true
      ensureBuilt()
      setTimeout(() => !run && startRun(prompts[0], false), reduceMotion ? 0 : 600)
    },
    { threshold: 0.6 },
  ).observe(term)

  // Si se llega con un ancla de respuesta, se pregunta al cargar. Se espera a `load`
  // porque hasta entonces el navegador insiste en llevar la página al ancla.
  const pending = fromHash(location.hash)
  if (pending) {
    started = true
    const go = () => ask(pending)
    if (document.readyState === "complete") go()
    else addEventListener("load", () => requestAnimationFrame(go), { once: true })
  }

  setPaused(false)

  compact.addEventListener("change", () => {
    if (!isBuilt) return
    built = build()
    if (run) {
      const t = elapsed
      enter(index)
      elapsed = t
      draw()
    }
  })
</script>

