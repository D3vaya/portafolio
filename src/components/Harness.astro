---
import { CONTEXT_WINDOW, layers, steps } from "@/data/harness"

const layerName = Object.fromEntries(layers.map((l) => [l.id, l.name]))
const first = steps[0]
const windowK = `${CONTEXT_WINDOW / 1000}k`
---

<section class="harness" id="harness" aria-labelledby="harness-title">
  <div class="wrap head">
    <h2 id="harness-title">Harness engineering</h2>
    <p class="problem">
      Todo lo que rodea al modelo para que un agente trabaje bien: contexto, herramientas, controles y pruebas. Así se ve
      por dentro lo que hace Claude Code cuando le llega un prompt, en una simulación.
    </p>
  </div>

  <div class="wrap run" data-run>
    <div class="board" data-board>
      <dl class="hud" aria-label="Contadores de la simulación">
        <div><dt>Tokens en contexto</dt><dd data-hud="tokens">0</dd></div>
        <div><dt>Desde caché</dt><dd data-hud="cached">0</dd></div>
        <div><dt>Herramientas usadas</dt><dd data-hud="tools">0</dd></div>
        <div><dt>Bloqueos</dt><dd data-hud="blocked">0</dd></div>
      </dl>
      <div class="canvas" data-canvas aria-hidden="true"></div>
      <div class="gauge" aria-hidden="true">
        <p class="gauge-head">
          <span class="gauge-title">Ventana de contexto <span class="gauge-tag">simulación</span></span>
          <span class="gauge-total" data-gauge-total>0 de {windowK} tokens</span>
        </p>
        <div class="gauge-track">
          <div class="gauge-bar" data-gauge-bar></div>
          <span class="gauge-cache" data-gauge-cache><span>en caché</span></span>
        </div>
        <ul class="gauge-legend" data-gauge-legend></ul>
      </div>
    </div>

    <div class="caption" aria-live="polite">
      <p class="caption-meta">
        <span data-step-count>Paso 1 de {steps.length}</span>
        <span class="caption-layer" data-step-layer>{first.layer ? `Capa: ${layerName[first.layer]}` : ""}</span>
      </p>
      <h3 data-step-title>{first.title}</h3>
      <p data-step-text>{first.text}</p>
    </div>

    <div class="controls">
      <button class="toggle" type="button" data-toggle aria-pressed="false">Pausar</button>
      <ol class="steps" aria-label="Pasos de la corrida" style={`--n: ${steps.length}`}>
        {
          steps.map((s, i) => (
            <li>
              <button type="button" data-step={i} aria-label={`Paso ${i + 1}: ${s.title}`} aria-current={i === 0 ? "step" : undefined}>
                <span class="steps-bar" />
                <span class="steps-title">{s.title}</span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

</section>

<script>
  import { CONTEXT_WINDOW, layers, steps, type Message, type Segment, type Step } from "@/data/harness"

  const layerName: Record<string, string> = Object.fromEntries(layers.map((l) => [l.id, l.name]))

  const NS = "http://www.w3.org/2000/svg"
  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches
  const compact = matchMedia("(max-width: 40rem)")
  const TRAVEL = 1150

  // ---------- Diagrama: nodos y pistas, en horizontal y en vertical ----------
  type Pos = { x: number; y: number }
  type Mode = "wide" | "tall"
  const nodes: Record<string, { title: string; sub: string; wide: Pos; tall: Pos }> = {
    usuario: { title: "Usuario", sub: "escribe el prompt", wide: { x: 130, y: 90 }, tall: { x: 80, y: 45 } },
    modelo: { title: "Modelo", sub: "razona y propone", wide: { x: 500, y: 70 }, tall: { x: 320, y: 45 } },
    memoria: { title: "Memoria", sub: "CLAUDE.md y notas", wide: { x: 130, y: 320 }, tall: { x: 80, y: 160 } },
    cache: { title: "Caché de prompt", sub: "inicio repetido", wide: { x: 870, y: 320 }, tall: { x: 320, y: 160 } },
    core: { title: "Claude Code", sub: "el harness", wide: { x: 500, y: 320 }, tall: { x: 200, y: 320 } },
    skills: { title: "Skills", sub: "bajo demanda", wide: { x: 130, y: 550 }, tall: { x: 80, y: 530 } },
    herramientas: { title: "Herramientas", sub: "lee, edita, ejecuta", wide: { x: 500, y: 600 }, tall: { x: 320, y: 530 } },
    navegador: { title: "Navegador", sub: "servidor MCP", wide: { x: 870, y: 600 }, tall: { x: 320, y: 650 } },
  }

  // Cada pista va de centro a centro pasando por `via`, siempre en ángulo recto.
  // Los tramos que caen dentro de un chip quedan tapados por él.
  const edges: { a: string; b: string; wide: Pos[]; tall: Pos[]; hook?: boolean }[] = [
    { a: "usuario", b: "core", wide: [{ x: 300, y: 90 }, { x: 300, y: 270 }, { x: 500, y: 270 }], tall: [{ x: 170, y: 45 }, { x: 170, y: 320 }] },
    { a: "modelo", b: "core", wide: [], tall: [{ x: 230, y: 45 }, { x: 230, y: 320 }] },
    { a: "memoria", b: "core", wide: [], tall: [{ x: 80, y: 320 }] },
    { a: "skills", b: "core", wide: [{ x: 300, y: 550 }, { x: 300, y: 370 }, { x: 500, y: 370 }], tall: [{ x: 80, y: 320 }] },
    { a: "cache", b: "core", wide: [], tall: [{ x: 320, y: 320 }] },
    { a: "core", b: "herramientas", wide: [], tall: [{ x: 320, y: 320 }], hook: true },
    { a: "herramientas", b: "navegador", wide: [], tall: [] },
  ]

  // hook: dónde va la insignia y dónde se detiene lo bloqueado, como fracción de la pista
  const layout = {
    wide: { w: 1000, h: 660, node: { w: 180, h: 70 }, core: { w: 230, h: 220 }, font: 19, packet: 17, bubble: 18, hook: { at: 0.73, stop: 0.54 } },
    tall: { w: 400, h: 685, node: { w: 118, h: 58 }, core: { w: 300, h: 140 }, font: 14, packet: 14, bubble: 14, hook: { at: 0.84, stop: 0.68 } },
  }

  const el = (tag: string, attrs: Record<string, string | number> = {}, parent?: Element) => {
    const node = document.createElementNS(NS, tag) as SVGGraphicsElement
    for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, String(v))
    parent?.appendChild(node)
    return node
  }

  const routePath = (p: Pos, via: Pos[], q: Pos) => [p, ...via, q].map((v, i) => `${i ? "L" : "M"}${v.x} ${v.y}`).join(" ")

  // Mascota de Claude Code dibujada desde su arte de terminal:
  //  ▐▛███▜▌
  // ▝▜█████▛▘
  //   ▘▘ ▝▝
  // Cada carácter son 2×2 cuadrantes; cada cuadrante mide 1 de ancho por 2 de alto.
  const BODY = [
    "...############...",
    "...##.######.##...",
    "..###############.",
    ".#.############...",
  ]
  const mascot = (parent: Element, size: number) => {
    const g = el("g", { class: "mascot", "shape-rendering": "crispEdges" }, parent)
    const u = size / 18
    const px = (x: number, y: number, cls: string) =>
      el("rect", { class: cls, x: x * u, y: y * u * 2, width: u + 0.6, height: u * 2 + 0.6 }, g)
    BODY.forEach((row, y) => [...row].forEach((c, x) => c === "#" && px(x, y, "body")))
    px(5, 1, "eye")
    px(12, 1, "eye")
    px(4, 4, "leg leg-a")
    px(6, 4, "leg leg-b")
    px(11, 4.5, "leg leg-a")
    px(13, 4.5, "leg leg-b")
    return g
  }

  type Built = {
    svg: SVGSVGElement
    mode: Mode
    nodeEls: Record<string, Element>
    paths: Map<string, SVGPathElement>
    signals: Map<string, SVGPathElement>
    packets: Element
    bubble: { g: Element; rect: Element; text: SVGTextElement }
  }

  const canvas = document.querySelector<HTMLElement>("[data-canvas]")!
  const board = document.querySelector<HTMLElement>("[data-board]")!
  let built: Built

  const build = (): Built => {
    const mode: Mode = compact.matches ? "tall" : "wide"
    const L = layout[mode]
    canvas.replaceChildren()
    const svg = el("svg", { viewBox: `0 0 ${L.w} ${L.h}`, class: "board-svg" }) as SVGSVGElement
    svg.style.setProperty("--font", `${L.font}px`)
    svg.style.setProperty("--packet", `${L.packet}px`)
    svg.style.setProperty("--bubble", `${L.bubble}px`)
    canvas.appendChild(svg)

    const tracesG = el("g", {}, svg)
    const paths = new Map<string, SVGPathElement>()
    const signals = new Map<string, SVGPathElement>()
    const pos = (id: string) => nodes[id][mode]

    edges.forEach((e, i) => {
      const d = routePath(pos(e.a), e[mode], pos(e.b))
      const key = `${e.a}>${e.b}`
      const trace = el("path", { d, class: "trace" }, tracesG) as SVGPathElement
      const len = trace.getTotalLength()
      trace.style.setProperty("--len", String(len))
      trace.style.setProperty("--d", `${i * 90}ms`)
      paths.set(key, trace)
      signals.set(key, el("path", { d, class: "trace-signal" }, tracesG) as SVGPathElement)
      if (e.hook) {
        const mid = trace.getPointAtLength(len * L.hook.at)
        const hook = el("g", { transform: `translate(${mid.x} ${mid.y})` }, tracesG)
        const body = el("g", { class: "hook" }, hook)
        el("rect", { x: -30, y: -13, width: 60, height: 26, rx: 13 }, body)
        el("text", { y: 5, "text-anchor": "middle" }, body).textContent = "hook"
      }
    })

    const nodesG = el("g", {}, svg)
    const nodeEls: Record<string, Element> = {}
    Object.entries(nodes).forEach(([id, n], i) => {
      const p = pos(id)
      const isCore = id === "core"
      const size = isCore ? L.core : L.node
      const outer = el("g", { transform: `translate(${p.x} ${p.y})` }, nodesG)
      const g = el("g", { class: `node${isCore ? " is-core" : ""}` }, outer)
      g.style.setProperty("--d", `${300 + i * 70}ms`)
      el("rect", { class: "chip", x: -size.w / 2, y: -size.h / 2, width: size.w, height: size.h, rx: 8 }, g)
      for (const side of [-1, 1]) {
        for (let k = 1; k <= 3; k++) {
          const y = -size.h / 2 + (size.h / 4) * k
          el("rect", { class: "pin", x: side > 0 ? size.w / 2 : -size.w / 2 - 6, y: y - 2, width: 6, height: 4 }, g)
        }
      }
      if (isCore && mode === "wide") {
        const holder = el("g", { transform: `translate(${-size.w * 0.3} ${-size.h * 0.4})` }, g)
        mascot(holder, size.w * 0.6)
        el("text", { class: "node-title", y: size.h * 0.25, "text-anchor": "middle" }, g).textContent = n.title
        el("text", { class: "node-sub", y: size.h * 0.25 + L.font * 1.2, "text-anchor": "middle" }, g).textContent = n.sub
      } else if (isCore) {
        // En vertical el chip es ancho: la mascota a la izquierda y el globo dentro, a su derecha
        const holder = el("g", { transform: `translate(${-size.w / 2 + 15} ${-size.h / 2 + 16})` }, g)
        mascot(holder, 84)
        const cx = -size.w / 2 + 57
        el("text", { class: "node-title", x: cx, y: size.h * 0.2, "text-anchor": "middle" }, g).textContent = n.title
        el("text", { class: "node-sub", x: cx, y: size.h * 0.2 + L.font * 1.2, "text-anchor": "middle" }, g).textContent = n.sub
      } else {
        el("text", { class: "node-title", y: -2, "text-anchor": "middle" }, g).textContent = n.title
        el("text", { class: "node-sub", y: L.font * 1.05, "text-anchor": "middle" }, g).textContent = n.sub
      }
      nodeEls[id] = g
    })

    // Globo de diálogo de la mascota
    const core = pos("core")
    const b = L.bubble
    const at = mode === "wide" ? { x: core.x + L.core.w * 0.12, y: core.y - L.core.h / 2 - b * 1.9 } : { x: core.x - 38, y: core.y - 14 }
    const bubbleG = el("g", { transform: `translate(${at.x} ${at.y})` }, svg)
    const bubble = el("g", { class: `bubble is-${mode}` }, bubbleG)
    const rect = el("rect", { x: 0, y: -b * 1.05, height: b * 2.1, rx: b * 1.05 }, bubble)
    const tail = mode === "wide" ? `M${b * 0.8} ${b * 0.9} l${-b * 0.5} ${b * 0.9} l${b * 1.1} ${-b * 0.9}z` : `M${b * 0.5} ${-b * 0.5} l${-b * 1.1} ${b * 0.5} l${b * 1.1} ${b * 0.5}z`
    el("path", { class: "bubble-tail", d: tail }, bubble)
    const text = el("text", { x: b * 0.9, y: b * 0.36 }, bubble) as SVGTextElement

    return { svg, mode, nodeEls, paths, signals, packets: el("g", {}, svg), bubble: { g: bubble, rect, text } }
  }

  // ---------- Ventana de contexto ----------
  // Se recalcula desde los datos: todo lo de los pasos previos más lo que ya ocurrió en el actual
  const contextAt = (i: number, t: number) => {
    const segs: Segment[] = []
    let cached = false
    steps.slice(0, i + 1).forEach((s, k) => {
      const now = k < i ? Infinity : t
      const c = s.context
      if (!c) return
      for (const a of c.add ?? []) {
        if ((a.delay ?? 0) > now) continue
        const found = segs.find((x) => x.id === a.id)
        if (found) found.tokens += a.tokens
        else segs.push({ ...a })
      }
      if (c.cache && c.cache.delay <= now) cached = true
      if (c.compact && c.compact.delay <= now) {
        segs.splice(0, segs.length, ...segs.filter((x) => x.fixed || x.keep))
        segs.push({ id: "resumen", label: "Resumen", tokens: c.compact.tokens })
      }
    })
    const total = segs.reduce((n, x) => n + x.tokens, 0)
    const prefix = segs.filter((x) => x.fixed).reduce((n, x) => n + x.tokens, 0)
    return { segs, cached, total, prefix }
  }

  const fmt = (n: number) => (n < 1000 ? String(n) : `${Math.round(n / 100) / 10}k`.replace(".", ","))

  const gauge = {
    bar: document.querySelector<HTMLElement>("[data-gauge-bar]")!,
    cache: document.querySelector<HTMLElement>("[data-gauge-cache]")!,
    legend: document.querySelector<HTMLElement>("[data-gauge-legend]")!,
    total: document.querySelector<HTMLElement>("[data-gauge-total]")!,
  }
  const segEls = new Map<string, HTMLElement>()
  let gaugeKey = ""

  const renderContext = (ctx: ReturnType<typeof contextAt>) => {
    hud.tokens.textContent = fmt(ctx.total)
    hud.cached.textContent = fmt(ctx.cached ? ctx.prefix : 0)
    const key = `${ctx.cached}|${ctx.segs.map((s) => `${s.id}:${s.tokens}`).join()}`
    if (key === gaugeKey) return
    gaugeKey = key
    const pct = (n: number) => `${(n / CONTEXT_WINDOW) * 100}%`
    const ids = new Set(ctx.segs.map((s) => s.id))
    // Los tramos que salen se encogen antes de desaparecer
    for (const [id, node] of segEls) {
      if (ids.has(id)) continue
      segEls.delete(id)
      node.style.width = "0%"
      setTimeout(() => node.remove(), reduceMotion ? 0 : 700)
    }
    for (const s of ctx.segs) {
      let node = segEls.get(s.id)
      if (!node) {
        node = document.createElement("span")
        node.className = "seg"
        node.dataset.seg = s.id
        node.style.width = "0%"
        gauge.bar.appendChild(node)
        segEls.set(s.id, node)
        void node.offsetWidth
      }
      node.style.width = pct(s.tokens)
      node.classList.toggle("is-cached", ctx.cached && Boolean(s.fixed))
    }
    gauge.cache.style.width = pct(ctx.prefix)
    gauge.cache.classList.toggle("is-on", ctx.cached)
    gauge.total.classList.toggle("is-full", ctx.total / CONTEXT_WINDOW >= 0.9)
    gauge.total.textContent = `${fmt(ctx.total)} de ${fmt(CONTEXT_WINDOW)} tokens · ${Math.round((ctx.total / CONTEXT_WINDOW) * 100)} %`
    gauge.legend.replaceChildren(
      ...ctx.segs.map((s) => {
        const li = document.createElement("li")
        li.dataset.seg = s.id
        li.classList.toggle("is-cached", ctx.cached && Boolean(s.fixed))
        const sw = document.createElement("i")
        const b = document.createElement("b")
        b.textContent = fmt(s.tokens)
        li.append(sw, `${s.label} `, b)
        return li
      }),
    )
  }

  // ---------- Línea de tiempo ----------
  const stepDuration = (s: Step) => {
    const c = s.context
    return Math.max(
      4400,
      ...s.messages.map((m) => (m.delay ?? 0) + TRAVEL + (m.blocked ? 2000 : 1400)),
      ...(c?.add ?? []).map((a) => (a.delay ?? 0) + 1400),
      c?.compact ? c.compact.delay + 2400 : 0,
    )
  }

  // Una llamada a herramienta: lo que el harness manda a la terminal o a un servidor MCP
  const isToolCall = (m: Message) => !m.blocked && (m.to === "navegador" || (m.to === "herramientas" && m.from === "core"))

  type Live = { packet: Element; label: SVGTextElement; path: SVGPathElement; signal: SVGPathElement; reverse: boolean; arrived: boolean; counted: boolean }
  let index = 0
  let elapsed = 0
  let last = 0
  let userPaused = reduceMotion
  let visible = false
  let booted = reduceMotion
  let live: Live[] = []
  const counts = { tools: 0, blocked: 0 }

  const hud = Object.fromEntries(
    [...document.querySelectorAll<HTMLElement>("[data-hud]")].map((d) => [d.dataset.hud!, d]),
  ) as Record<"tokens" | "cached" | "tools" | "blocked", HTMLElement>
  const renderHud = () => {
    hud.tools.textContent = String(counts.tools)
    hud.blocked.textContent = String(counts.blocked)
  }

  // Contadores acumulados de los pasos ya completos
  const countBefore = (i: number) => {
    counts.tools = 0
    counts.blocked = 0
    for (const m of steps.slice(0, i).flatMap((s) => s.messages)) {
      if (m.blocked) counts.blocked++
      if (isToolCall(m)) counts.tools++
    }
  }

  const findPath = (from: string, to: string) => {
    const key = built.paths.has(`${from}>${to}`) ? `${from}>${to}` : `${to}>${from}`
    return { path: built.paths.get(key)!, signal: built.signals.get(key)!, reverse: key !== `${from}>${to}` }
  }

  const sizeRect = (rect: Element, label: SVGTextElement, pad: number) => {
    const w = label.getComputedTextLength() + pad
    rect.setAttribute("x", String(-w / 2))
    rect.setAttribute("width", String(w))
  }

  const makePacket = (text: string) => {
    const big = built.mode === "wide"
    const g = el("g", { class: "packet" }, built.packets)
    const rect = el("rect", { rx: big ? 17 : 14, y: big ? -17 : -14, height: big ? 34 : 28 }, g)
    const label = el("text", { "text-anchor": "middle", y: big ? 6 : 5 }, g) as SVGTextElement
    label.textContent = text
    sizeRect(rect, label, 26)
    return { packet: g, label }
  }

  const caption = {
    count: document.querySelector("[data-step-count]")!,
    layer: document.querySelector("[data-step-layer]")!,
    title: document.querySelector("[data-step-title]")!,
    text: document.querySelector("[data-step-text]")!,
  }
  const stepButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-step]")]
  let sayFull = ""

  const enter = (i: number) => {
    index = (i + steps.length) % steps.length
    elapsed = 0
    const s = steps[index]
    // Sin animación el paso se muestra ya completo
    countBefore(reduceMotion ? index + 1 : index)
    renderHud()
    built.packets.replaceChildren()
    for (const signal of built.signals.values()) signal.classList.remove("is-on")
    live = s.messages.map((m) => ({ ...makePacket(m.label), ...findPath(m.from, m.to), arrived: false, counted: false }))
    for (const [id, g] of Object.entries(built.nodeEls)) {
      g.classList.toggle("is-active", s.active.includes(id))
      g.classList.remove("is-pulse", "is-alarmed")
    }
    built.nodeEls.core.classList.toggle("is-thinking", s.layer === "modelo")

    // El globo se dimensiona con el texto completo y luego se escribe letra a letra
    sayFull = s.say
    const { rect, text, g } = built.bubble
    text.textContent = sayFull
    const w = text.getComputedTextLength() + Number(text.getAttribute("x")) * 2
    rect.setAttribute("width", String(w))
    text.textContent = reduceMotion ? sayFull : ""
    g.classList.remove("is-in")
    void g.getBoundingClientRect()
    g.classList.add("is-in")

    caption.count.textContent = `Paso ${index + 1} de ${steps.length}`
    caption.layer.textContent = s.layer ? `Capa: ${layerName[s.layer]}` : ""
    caption.title.textContent = s.title
    caption.text.textContent = s.text
    stepButtons.forEach((b, k) => {
      if (k === index) b.setAttribute("aria-current", "step")
      else b.removeAttribute("aria-current")
      b.classList.toggle("is-done", k < index)
      b.style.setProperty("--p", "0")
    })
    draw()
  }

  const draw = () => {
    const s = steps[index]
    const stop = layout[built.mode].hook.stop
    let busy = false
    s.messages.forEach((m, k) => {
      const item = live[k]
      // Con movimiento reducido cada mensaje queda quieto a mitad de camino, y lo bloqueado, en el hook
      const raw = reduceMotion ? (m.blocked ? stop : 0.5) : (elapsed - (m.delay ?? 0)) / TRAVEL
      const t = Math.min(Math.max(raw, 0), m.blocked ? stop : 1)
      const len = item.path.getTotalLength()
      const at = item.path.getPointAtLength(len * (item.reverse ? 1 - t : t))
      const moving = raw >= 0 && raw <= 1
      const blocked = Boolean(m.blocked) && raw >= stop
      item.packet.setAttribute("transform", `translate(${at.x} ${at.y})`)
      item.packet.classList.toggle("is-visible", reduceMotion || moving || blocked)
      if (blocked && !item.packet.classList.contains("is-blocked")) {
        item.packet.classList.add("is-blocked")
        item.label.textContent = "bloqueado por hook"
        sizeRect(item.packet.querySelector("rect")!, item.label, 26)
        built.nodeEls[m.from].classList.add("is-alarmed")
      }
      item.signal.classList.toggle("is-on", moving && !blocked)
      if (moving && (m.from === "core" || m.to === "core")) busy = true
      if (!item.counted && !reduceMotion && (raw >= 1 || blocked)) {
        item.counted = true
        if (m.blocked) counts.blocked++
        if (isToolCall(m)) counts.tools++
        renderHud()
      }
      if (!item.arrived && raw >= 1 && !m.blocked) {
        item.arrived = true
        const target = built.nodeEls[m.to]
        target.classList.remove("is-pulse")
        void target.getBoundingClientRect()
        target.classList.add("is-pulse")
      }
    })
    renderContext(contextAt(index, reduceMotion ? Infinity : elapsed))
    built.nodeEls.core.classList.toggle("is-busy", busy)
    if (!reduceMotion) built.bubble.text.textContent = sayFull.slice(0, Math.floor(elapsed / 38))
    stepButtons[index].style.setProperty("--p", String(Math.min(1, elapsed / stepDuration(s))))
  }

  // El bucle solo corre mientras la animación avanza; se reactiva con kick()
  let raf = 0
  const running = () => !userPaused && visible && booted
  const loop = (now: number) => {
    if (!running()) {
      raf = 0
      last = 0
      return
    }
    const dt = last ? Math.min(now - last, 100) : 0
    last = now
    elapsed += dt
    if (elapsed >= stepDuration(steps[index])) enter(index + 1)
    else draw()
    raf = requestAnimationFrame(loop)
  }
  const kick = () => {
    if (!raf && running()) raf = requestAnimationFrame(loop)
  }

  // ---------- Arranque: las pistas se dibujan y los chips se encienden ----------
  const boot = () => {
    board.classList.add("is-booted")
    if (reduceMotion) return
    setTimeout(() => {
      booted = true
      enter(0)
      kick()
    }, 1700)
  }

  // ---------- Controles ----------
  const toggle = document.querySelector<HTMLButtonElement>("[data-toggle]")!
  const setPaused = (p: boolean) => {
    userPaused = p
    toggle.textContent = p ? "Reproducir" : "Pausar"
    toggle.setAttribute("aria-pressed", String(p))
    kick()
  }
  toggle.addEventListener("click", () => setPaused(!userPaused))
  stepButtons.forEach((b, k) =>
    b.addEventListener("click", () => {
      ensureBuilt()
      booted = true
      board.classList.add("is-booted")
      enter(k)
      kick()
    }),
  )

  // El diagrama se construye recién cuando la sección se acerca a la pantalla:
  // medir el SVG al cargar la página retrasaba el primer pintado
  let isBuilt = false
  const ensureBuilt = () => {
    if (isBuilt) return
    isBuilt = true
    built = build()
    enter(0)
  }

  new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) ensureBuilt()
    },
    { rootMargin: "100% 0px" },
  ).observe(board)

  let started = false
  new IntersectionObserver(
    ([entry]) => {
      visible = entry.isIntersecting
      if (visible && !started) {
        ensureBuilt()
        started = true
        boot()
      }
      kick()
    },
    { threshold: 0.25 },
  ).observe(board)

  setPaused(userPaused)

  compact.addEventListener("change", () => {
    if (!isBuilt) return
    built = build()
    enter(index)
  })
</script>


