<div id="particles-container" aria-hidden="true"></div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Skip entirely on reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const container = document.getElementById('particles-container');
    if (!container) return;

    // Fewer particles = less compositor work. 15 is plenty for ambiance.
    const PARTICLE_COUNT = 15;
    const colors = ['#00ff9f', '#ff006f', '#ffffff', '#00d4ff'];

    // Batch DOM writes with DocumentFragment (js-batch-dom-css)
    const fragment = document.createDocumentFragment();

    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const p = document.createElement('div');
      p.className = 'floating-particle';

      const size = Math.random() * 3 + 1;
      const duration = Math.random() * 25 + 15;
      const delay = Math.random() * 10;

      // Single cssText write instead of multiple style assignments (js-batch-dom-css)
      p.style.cssText = `
        left: ${Math.random() * 100}%;
        top: ${Math.random() * 100}%;
        width: ${size}px;
        height: ${size}px;
        animation-duration: ${duration}s;
        animation-delay: ${delay}s;
        background-color: ${colors[(Math.random() * colors.length) | 0]};
      `;

      fragment.appendChild(p);
    }

    // Single DOM write — one reflow instead of 15
    container.appendChild(fragment);

    // Pause animations when tab hidden
    document.addEventListener('visibilitychange', () => {
      container.style.animationPlayState = document.hidden ? 'paused' : 'running';
    });
  });
</script>

<style>
  #particles-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: -5;
    contain: strict;
  }

  .floating-particle {
    position: absolute;
    border-radius: 50%;
    opacity: 0.5;
    animation: float linear infinite;
    pointer-events: none;
    will-change: transform, opacity;
  }

  @keyframes float {
    0% {
      transform: translateY(100vh) translateX(0px);
      opacity: 0;
    }
    10% {
      opacity: 0.5;
    }
    90% {
      opacity: 0.5;
    }
    100% {
      transform: translateY(-100px) translateX(80px);
      opacity: 0;
    }
  }

  .floating-particle:nth-child(odd) {
    animation-name: floatReverse;
  }

  @keyframes floatReverse {
    0% {
      transform: translateY(-100px) translateX(80px);
      opacity: 0;
    }
    10% {
      opacity: 0.35;
    }
    90% {
      opacity: 0.35;
    }
    100% {
      transform: translateY(100vh) translateX(-80px);
      opacity: 0;
    }
  }

  .floating-particle:nth-child(3n) {
    animation-name: floatDiagonal;
  }

  @keyframes floatDiagonal {
    0% {
      transform: translateY(100vh) translateX(-40px);
      opacity: 0;
    }
    50% {
      opacity: 0.6;
      transform: translateY(50vh) translateX(40px);
    }
    100% {
      transform: translateY(-100px) translateX(100px);
      opacity: 0;
    }
  }
</style>
