---
---

<div id="page-loader" class="page-loader">
  <div class="loader-content">
    <div class="boot-lines">
      <div class="boot-line" data-line="0">
        <span class="prompt">&gt;</span>
        <span class="text">Initializing system...</span>
      </div>
      <div class="boot-line" data-line="1">
        <span class="prompt">&gt;</span>
        <span class="text">Loading modules... [React, Next.js, TypeScript]</span>
      </div>
      <div class="boot-line" data-line="2">
        <span class="prompt">&gt;</span>
        <span class="text">Connecting to portfolio.api...</span>
      </div>
      <div class="boot-line" data-line="3">
        <span class="prompt">&gt;</span>
        <span class="text">Rendering components...</span>
      </div>
      <div class="boot-line" data-line="4">
        <span class="prompt">&gt;</span>
        <span class="text ready-text">System ready. Welcome.</span>
      </div>
    </div>
    <div class="progress-bar">
      <div class="progress-fill"></div>
    </div>
  </div>
</div>

<script>
  import { gsap, ScrollTrigger, prefersReducedMotion } from "@/scripts/gsap-init";

  document.addEventListener("DOMContentLoaded", () => {
    const loader = document.getElementById("page-loader");
    if (!loader) return;

    if (prefersReducedMotion()) {
      loader.remove();
      return;
    }

    const lines = loader.querySelectorAll(".boot-line");
    const progressFill = loader.querySelector(".progress-fill");
    const isMobile = window.innerWidth < 768;
    const totalDuration = isMobile ? 1.5 : 2.5;
    const lineDelay = totalDuration / (lines.length + 1);

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.to(loader, {
          clipPath: "inset(0 0 100% 0)",
          duration: 0.6,
          ease: "power4.inOut",
          onComplete: () => {
            loader.remove();
            ScrollTrigger.refresh();
          },
        });
      },
    });

    // Progress bar animation
    tl.to(progressFill, {
      scaleX: 1,
      duration: totalDuration,
      ease: "power1.inOut",
    }, 0);

    // Boot lines stagger
    lines.forEach((line, i) => {
      tl.fromTo(
        line,
        { opacity: 0, x: -20 },
        { opacity: 1, x: 0, duration: 0.3, ease: "power2.out" },
        i * lineDelay
      );
    });
  });
</script>

<style>
  .page-loader {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    clip-path: inset(0 0 0 0);
  }

  .loader-content {
    max-width: 500px;
    width: 90%;
    font-family: "JetBrains Mono", monospace;
  }

  .boot-lines {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 30px;
  }

  .boot-line {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
    opacity: 0;
  }

  .prompt {
    color: #00ff9f;
    font-weight: 700;
  }

  .text {
    color: #b3b3b3;
  }

  .ready-text {
    color: #00ff9f;
    font-weight: 600;
    text-shadow: 0 0 10px rgba(0, 255, 159, 0.5);
  }

  .progress-bar {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, #00ff9f, #00d4ff);
    transform: scaleX(0);
    transform-origin: left;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(0, 255, 159, 0.5);
  }

  @media (max-width: 768px) {
    .boot-line {
      font-size: 0.75rem;
    }

    .boot-lines {
      gap: 8px;
    }
  }
</style>
