---
import Section from "../Section.astro"
import { education } from "@cv"

const sorted = [...education].sort(
  (a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime()
)

const getTimingMs = (start: string, end: string | undefined) => {
  const s = new Date(start).getTime()
  const e = end ? new Date(end).getTime() : Date.now()
  const months = Math.round((e - s) / (1000 * 60 * 60 * 24 * 30))
  return months
}

const barColors = ["#00d4ff", "#c678dd", "#ffd700", "#ff006e", "#00ff9f", "#61afef"]

// Calculate waterfall offsets (relative to earliest start)
const earliest = new Date(sorted[0]?.startDate || "2013-01-01").getTime()
const latest = Math.max(
  ...sorted.map(e => (e.endDate ? new Date(e.endDate).getTime() : Date.now()))
)
const totalSpan = latest - earliest

const getWaterfallOffset = (start: string) => {
  const s = new Date(start).getTime()
  return ((s - earliest) / totalSpan) * 100
}

const getWaterfallWidth = (start: string, end: string | undefined) => {
  const s = new Date(start).getTime()
  const e = end ? new Date(end).getTime() : Date.now()
  return Math.max(((e - s) / totalSpan) * 100, 8)
}
---

<Section title="> education --network">
  <div class="net-window" id="edu-network">
    <!-- Title bar -->
    <div class="net-titlebar">
      <div class="net-dots">
        <span class="ndot ndot-r"></span>
        <span class="ndot ndot-y"></span>
        <span class="ndot ndot-g"></span>
      </div>
      <span class="net-title">DevTools — Network</span>
    </div>

    <!-- Toolbar -->
    <div class="net-toolbar" data-net-toolbar>
      <div class="net-toolbar-tabs">
        <span class="net-tb-tab">Elements</span>
        <span class="net-tb-tab">Console</span>
        <span class="net-tb-tab net-tb-active">Network</span>
        <span class="net-tb-tab">Sources</span>
        <span class="net-tb-tab">Performance</span>
      </div>
      <div class="net-filter-row">
        <span class="net-filter-pill net-filter-active">All</span>
        <span class="net-filter-pill">XHR</span>
        <span class="net-filter-pill">Doc</span>
        <span class="net-filter-pill">JS</span>
        <span class="net-filter-pill">CSS</span>
      </div>
    </div>

    <!-- Table header -->
    <div class="net-table-header">
      <span class="net-col net-col-status">Status</span>
      <span class="net-col net-col-name">Name</span>
      <span class="net-col net-col-type">Type</span>
      <span class="net-col net-col-size">Duration</span>
      <span class="net-col net-col-waterfall">Waterfall</span>
    </div>

    <!-- Rows -->
    <div class="net-table-body">
      {sorted.map((edu, i) => {
        const months = getTimingMs(edu.startDate, edu.endDate)
        const startYear = new Date(edu.startDate).getFullYear()
        const endYear = edu.endDate ? new Date(edu.endDate).getFullYear() : "Present"
        const color = barColors[i % barColors.length]
        const offset = getWaterfallOffset(edu.startDate)
        const width = getWaterfallWidth(edu.startDate, edu.endDate)
        const resourceName = edu.area.toLowerCase().replace(/[\s]+/g, "-")

        return (
          <div class="net-row" data-net-row style={`--bar-color: ${color}`}>
            <span class="net-col net-col-status">
              <span class="net-status-badge">200</span>
            </span>
            <span class="net-col net-col-name">
              <span class="net-resource-name">{resourceName}.edu</span>
              <span class="net-resource-sub">{edu.institution}</span>
            </span>
            <span class="net-col net-col-type">
              <span class="net-type-badge">{edu.studyType || "degree"}</span>
            </span>
            <span class="net-col net-col-size">
              <span class="net-duration-val">{months}mo</span>
              <span class="net-duration-years">{startYear}–{endYear}</span>
            </span>
            <span class="net-col net-col-waterfall">
              <div class="net-waterfall-track">
                <div
                  class="net-waterfall-bar"
                  data-net-bar
                  style={`left: ${offset}%; width: ${width}%; background: ${color}`}
                >
                  <span class="net-waterfall-label">{startYear}–{endYear}</span>
                </div>
              </div>
            </span>
          </div>
        )
      })}
    </div>

    <!-- Footer -->
    <div class="net-footer" data-net-footer>
      <span>{sorted.length} requests</span>
      <span class="net-footer-sep">|</span>
      <span class="net-footer-transferred">{sorted.length} degrees transferred</span>
      <span class="net-footer-sep">|</span>
      <span class="net-footer-finish">Finish: career.loaded</span>
    </div>
  </div>
</Section>

<script>
  import { gsap, prefersReducedMotion } from "@/scripts/gsap-init";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("edu-network");
    if (!container) return;

    const rows = container.querySelectorAll("[data-net-row]");
    const bars = container.querySelectorAll("[data-net-bar]");
    const toolbar = container.querySelector("[data-net-toolbar]");

    if (prefersReducedMotion()) {
      rows.forEach(el => {
        (el as HTMLElement).style.opacity = "1";
        (el as HTMLElement).style.visibility = "visible";
      });
      bars.forEach(el => {
        (el as HTMLElement).style.transform = "scaleX(1)";
      });
      return;
    }

    // Window entrance
    gsap.fromTo(container,
      { scale: 0.96, autoAlpha: 0 },
      {
        scale: 1,
        autoAlpha: 1,
        duration: 0.6,
        ease: "power3.out",
        scrollTrigger: {
          trigger: container,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      }
    );

    // Toolbar clip-path reveal
    if (toolbar) {
      gsap.fromTo(toolbar,
        { clipPath: "inset(0 100% 0 0)" },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 0.5,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: container,
            start: "top 80%",
            toggleActions: "play none none none",
          },
          delay: 0.3,
        }
      );
    }

    // Rows stagger in
    gsap.fromTo(rows,
      { autoAlpha: 0, x: -15 },
      {
        autoAlpha: 1,
        x: 0,
        stagger: 0.15,
        duration: 0.4,
        ease: "power2.out",
        scrollTrigger: {
          trigger: container,
          start: "top 75%",
          toggleActions: "play none none none",
        },
        delay: 0.5,
      }
    );

    // Waterfall bars animate width
    bars.forEach((bar, i) => {
      gsap.fromTo(bar,
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: 0.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: container,
            start: "top 70%",
            toggleActions: "play none none none",
          },
          delay: 0.7 + i * 0.15,
        }
      );
    });
  });
</script>

<style>
  /* Network Window */
  .net-window {
    background: rgba(25, 25, 25, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    overflow: hidden;
    backdrop-filter: blur(12px);
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.04) inset;
  }

  /* Title bar */
  .net-titlebar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    background: rgba(37, 37, 38, 0.95);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .net-dots {
    display: flex;
    gap: 6px;
  }

  .ndot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .ndot-r { background: #ff5f57; }
  .ndot-y { background: #febc2e; }
  .ndot-g { background: #28c840; }

  .net-title {
    flex: 1;
    text-align: center;
    color: #888;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
  }

  /* Toolbar */
  .net-toolbar {
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 0 12px;
  }

  .net-toolbar-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }

  .net-tb-tab {
    padding: 8px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: #666;
    cursor: default;
    border-bottom: 2px solid transparent;
  }

  .net-tb-active {
    color: #00d4ff;
    border-bottom-color: #00d4ff;
  }

  .net-filter-row {
    display: flex;
    gap: 6px;
    padding: 8px 0;
  }

  .net-filter-pill {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    color: #666;
    padding: 2px 10px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    cursor: default;
  }

  .net-filter-active {
    color: #00d4ff;
    background: rgba(0, 212, 255, 0.12);
  }

  /* Table header */
  .net-table-header {
    display: flex;
    align-items: center;
    padding: 8px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(40, 40, 40, 0.6);
  }

  .net-table-header .net-col {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: #888;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  /* Columns */
  .net-col {
    font-family: 'JetBrains Mono', monospace;
  }

  .net-col-status { width: 55px; flex-shrink: 0; }
  .net-col-name { flex: 1.5; min-width: 0; }
  .net-col-type { width: 70px; flex-shrink: 0; }
  .net-col-size { width: 80px; flex-shrink: 0; }
  .net-col-waterfall { flex: 1.2; min-width: 100px; }

  /* Table body */
  .net-table-body {
    max-height: 400px;
  }

  .net-row {
    display: flex;
    align-items: center;
    padding: 10px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    transition: background 0.2s ease;
    cursor: default;
  }

  .net-row:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  /* Status */
  .net-status-badge {
    font-size: 0.7rem;
    color: #28c840;
    font-weight: 600;
  }

  /* Name */
  .net-col-name {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .net-resource-name {
    font-size: 0.78rem;
    color: #00d4ff;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .net-resource-sub {
    font-size: 0.65rem;
    color: #666;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Type */
  .net-type-badge {
    font-size: 0.62rem;
    color: #c678dd;
    background: rgba(198, 120, 221, 0.1);
    padding: 2px 6px;
    border-radius: 3px;
    text-transform: lowercase;
  }

  /* Size/Duration */
  .net-col-size {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .net-duration-val {
    font-size: 0.75rem;
    color: #e0e0e0;
    font-weight: 600;
  }

  .net-duration-years {
    font-size: 0.6rem;
    color: #555;
  }

  /* Waterfall */
  .net-waterfall-track {
    width: 100%;
    height: 18px;
    position: relative;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 3px;
  }

  .net-waterfall-bar {
    position: absolute;
    top: 2px;
    height: 14px;
    border-radius: 3px;
    transform-origin: left;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
    opacity: 0.85;
    box-shadow: 0 0 8px color-mix(in srgb, var(--bar-color) 30%, transparent);
  }

  .net-waterfall-label {
    font-size: 0.55rem;
    color: #fff;
    font-weight: 600;
    white-space: nowrap;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
  }

  /* Footer */
  .net-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(37, 37, 38, 0.6);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: #666;
  }

  .net-footer-sep {
    color: #444;
  }

  .net-footer-transferred {
    color: #00ff9f;
  }

  .net-footer-finish {
    color: #ffd700;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .net-col-type,
    .net-col-waterfall {
      display: none;
    }

    .net-table-header .net-col-type,
    .net-table-header .net-col-waterfall {
      display: none;
    }

    .net-col-name { flex: 1; }
    .net-col-size { width: 70px; }

    .net-row {
      padding: 8px 12px;
    }

    .net-table-header {
      padding: 6px 12px;
    }

    .net-toolbar-tabs {
      overflow-x: auto;
      scrollbar-width: none;
    }

    .net-toolbar-tabs::-webkit-scrollbar {
      display: none;
    }

    .net-tb-tab {
      padding: 6px 10px;
      font-size: 0.62rem;
      white-space: nowrap;
    }

    .ndot {
      width: 10px;
      height: 10px;
    }

    .net-footer {
      padding: 6px 12px;
      font-size: 0.6rem;
      flex-wrap: wrap;
    }

    .net-resource-name {
      font-size: 0.72rem;
    }
  }
</style>
