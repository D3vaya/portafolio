---
import Section from "../Section.astro"
import { work } from "@cv"

const branchColors = ["#00ff9f", "#00d4ff", "#ff006e", "#ffd700", "#c678dd", "#61afef"]
---

<Section title="Work Experience">
  <div class="git-graph" id="exp-timeline">
    <div class="git-header">
      <span class="git-cmd">$ git log --graph --oneline --all</span>
    </div>

    <div class="graph-body">
      <div class="graph-entries">
        {/* HEAD — current state */}
        <div class="commit-row head-row">
          <div class="graph-col">
            <span class="dot main-dot head-dot" data-commit></span>
          </div>
          <div class="row-label">
            <span class="head-tag">HEAD</span>
            <span class="head-branch">main</span>
            <span class="head-msg">current</span>
          </div>
        </div>

        {
          work.map(
            ({ name, startDate, endDate, position, summary, image, url }, index) => {
              const startYear = new Date(startDate).getFullYear()
              const endYear = endDate != null ? new Date(endDate).getFullYear() : "Present"
              const years = `${startYear} - ${endYear}`
              const color = branchColors[index % branchColors.length]
              const branchName = name.toLowerCase().replace(/[\s.]+/g, "-")

              return (
                <div class="graph-entry" data-exp-entry style={`--bc: ${color}`}>
                  {/* === ROW 1: Fork point on main === */}
                  <div class="commit-row fork-row" data-row="fork">
                    <div class="graph-col">
                      <span class="dot main-dot" data-commit></span>
                    </div>
                    <div class="row-label">
                      <span class="hash">{(0xA0B0C0 + index * 0x111111).toString(16).slice(0, 7)}</span>
                      <span class="branch-badge" style={`color: ${color}; border-color: ${color}`}>
                        feature/{branchName}
                      </span>
                      <span class="row-msg">checkout -b feature/{branchName}</span>
                    </div>
                  </div>

                  {/* === ROW 2: Commit — Company (on branch) === */}
                  <div class="commit-row branch-row" data-row="company">
                    <div class="graph-col">
                      <span class="dot branch-dot" data-commit style={`border-color: ${color}`}>
                        <span class="dot-inner" style={`background: ${color}`}></span>
                      </span>
                    </div>
                    <div class="row-content company-row">
                      <figure class="company-logo">
                        <img src={image} alt={name} width="38" height="38" loading="lazy" />
                      </figure>
                      <div>
                        <h3>
                          <a href={url} title={`View ${name}`} target="_blank" rel="noopener noreferrer">{name}</a>
                        </h3>
                        <time>{years}</time>
                      </div>
                    </div>
                  </div>

                  {/* === ROW 3: Commit — Position (on branch) === */}
                  <div class="commit-row branch-row" data-row="position">
                    <div class="graph-col">
                      <span class="dot branch-dot" data-commit style={`border-color: ${color}`}>
                        <span class="dot-inner" style={`background: ${color}`}></span>
                      </span>
                    </div>
                    <div class="row-content">
                      <span class="commit-msg"><span class="cm-key">role:</span> {position}</span>
                    </div>
                  </div>

                  {/* === ROW 4: Commit — Summary (on branch, merges back) === */}
                  <div class="commit-row branch-row last-branch" data-row="summary">
                    <div class="graph-col">
                      <span class="dot branch-dot" data-commit style={`border-color: ${color}`}>
                        <span class="dot-inner" style={`background: ${color}`}></span>
                      </span>
                    </div>
                    <div class="row-content summary-content">
                      <p>{summary}</p>
                    </div>
                  </div>

                  {/* === ROW 5: Merge back to main === */}
                  <div class="commit-row merge-row" data-row="merge">
                    <div class="graph-col">
                      <span class="dot main-dot merge-dot" data-commit></span>
                    </div>
                    <div class="row-label">
                      <span class="merge-tag" style={`color: ${color}`}>&#x2714; merge feature/{branchName} &rarr; main</span>
                    </div>
                  </div>
                </div>
              )
            }
          )
        }

        <div class="trunk-line" id="trunk-line"></div>
      </div>
    </div>
  </div>
</Section>

<script>
  import { gsap, prefersReducedMotion } from "@/scripts/gsap-init";

  document.addEventListener("DOMContentLoaded", () => {
    if (prefersReducedMotion()) {
      document.querySelectorAll("[data-commit], [data-row]").forEach(el => {
        (el as HTMLElement).style.opacity = "1";
        (el as HTMLElement).style.visibility = "visible";
      });
      const trunk = document.getElementById("trunk-line");
      if (trunk) trunk.style.transform = "scaleY(1)";
      return;
    }

    // Trunk line grows with scroll
    const trunk = document.getElementById("trunk-line");
    if (trunk) {
      gsap.fromTo(trunk,
        { scaleY: 0 },
        {
          scaleY: 1,
          ease: "none",
          scrollTrigger: {
            trigger: "#exp-timeline",
            start: "top 70%",
            end: "bottom 40%",
            scrub: 1,
          },
        }
      );
    }

    // Animate each entry
    document.querySelectorAll("[data-exp-entry]").forEach((entry) => {
      const rows = entry.querySelectorAll("[data-row]");
      const commits = entry.querySelectorAll("[data-commit]");

      // Set initial states
      rows.forEach(r => gsap.set(r, { autoAlpha: 0, x: 10 }));
      commits.forEach(c => gsap.set(c, { scale: 0 }));

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: entry,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      });

      // Animate each row sequentially
      rows.forEach((row, i) => {
        const commit = row.querySelector("[data-commit]");
        const offset = i === 0 ? 0 : "-=0.15";

        // Row fades in
        tl.to(row, {
          autoAlpha: 1,
          x: 0,
          duration: 0.35,
          ease: "power2.out",
        }, offset);

        // Commit dot pops
        if (commit) {
          tl.to(commit, {
            scale: 1,
            duration: 0.25,
            ease: "back.out(3)",
          }, "<");
        }
      });
    });

    // HEAD row
    const headRow = document.querySelector(".head-row");
    const headDot = document.querySelector(".head-dot");
    if (headRow && headDot) {
      gsap.set(headRow, { autoAlpha: 0 });
      gsap.set(headDot, { scale: 0 });
      gsap.to(headRow, {
        autoAlpha: 1,
        duration: 0.4,
        scrollTrigger: {
          trigger: headRow,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
      gsap.to(headDot, {
        scale: 1,
        duration: 0.3,
        ease: "back.out(3)",
        scrollTrigger: {
          trigger: headRow,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
    }
  });
</script>

<style>
  .git-graph {
    position: relative;
  }

  .git-header {
    background: rgba(0, 0, 0, 0.6);
    border: 1px solid rgba(0, 255, 159, 0.2);
    border-radius: 8px 8px 0 0;
    padding: 10px 16px;
    border-bottom: none;
  }

  .git-cmd {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
    color: #00ff9f;
  }

  .graph-body {
    position: relative;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(0, 255, 159, 0.2);
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 25px 15px 20px;
  }

  .trunk-line {
    position: absolute;
    left: 28px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: #00ff9f;
    transform-origin: top;
    z-index: 0;
    opacity: 0.4;
  }

  .graph-entries {
    position: relative;
    z-index: 1;
  }

  /* ── Entry wrapper ── */
  .graph-entry {
    position: relative;
    margin-bottom: 8px;
  }

  /* ── Each row ── */
  .commit-row {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 32px;
    position: relative;
  }

  /* ── Graph column (dots + lines) ── */
  .graph-col {
    width: 55px;
    min-width: 55px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    align-self: stretch;
    flex-shrink: 0;
  }

  /* ─────────────────────────────────────
     CONNECTOR SYSTEM — pseudo-elements
     No fixed heights, auto-stretch to row
     ───────────────────────────────────── */

  /* Horizontal fork connector: main → branch */
  .fork-row .graph-col::after {
    content: '';
    position: absolute;
    left: 29px;
    top: 50%;
    width: 20px;
    height: 2px;
    transform: translateY(-50%);
    background: var(--bc);
    opacity: 0.6;
    z-index: 1;
  }

  /* Vertical branch line on every branch row — extends generously to bridge row gaps */
  .branch-row .graph-col::before {
    content: '';
    position: absolute;
    left: 48px;
    top: -20px;
    bottom: -20px;
    width: 2px;
    background: var(--bc);
    opacity: 0.4;
    z-index: 1;
  }

  /* First branch row: extend upward further to reach the fork connector */
  .fork-row + .branch-row .graph-col::before {
    top: -40px;
  }

  /* Last branch row: extend downward further to reach the merge row */
  .last-branch .graph-col::before {
    bottom: -40px;
  }

  /* Horizontal merge-in connector: branch → main (on the last branch row) */
  .last-branch .graph-col::after {
    content: '';
    position: absolute;
    left: 29px;
    bottom: -20px;
    width: 20px;
    height: 2px;
    background: var(--bc);
    opacity: 0.6;
    z-index: 1;
  }

  /* Main branch dot */
  .dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex-shrink: 0;
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .main-dot {
    border: 2.5px solid #00ff9f;
    background: #0a0a0a;
    margin-left: 22px;
  }

  .main-dot::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00ff9f;
  }

  /* Branch dot (offset to the right) */
  .branch-dot {
    border: 2px solid;
    background: #0a0a0a;
    margin-left: 42px;
  }

  .dot-inner {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }

  .merge-dot {
    border-style: double;
    border-width: 3px;
  }

  /* ── Row content ── */
  .row-label {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-family: "JetBrains Mono", monospace;
    padding: 6px 0;
    min-height: 28px;
  }

  .hash {
    font-size: 0.7rem;
    color: #ffd700;
    opacity: 0.7;
  }

  .branch-badge {
    font-size: 0.68rem;
    padding: 2px 8px;
    border: 1px solid;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
  }

  .row-msg {
    font-size: 0.72rem;
    color: #888;
  }

  .merge-tag {
    font-size: 0.7rem;
    font-family: "JetBrains Mono", monospace;
    opacity: 0.7;
  }

  .row-content {
    flex: 1;
    padding: 6px 0;
    min-height: 28px;
    display: flex;
    align-items: center;
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(26, 26, 46, 0.5);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 8px;
    padding: 10px 14px;
    flex: 1;
    transition: all 0.3s ease;
  }

  .company-row:hover {
    border-color: rgba(0, 255, 159, 0.2);
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.3);
  }

  .company-logo {
    margin: 0;
  }

  .company-logo img {
    height: 38px;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
  }

  .company-row h3 {
    font-weight: 600;
    font-size: 0.95rem;
    color: #ffffff;
    margin: 0;
  }

  .company-row a {
    color: #00ff9f;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .company-row a:hover {
    color: #00d4ff;
    text-shadow: 0 0 8px rgba(0, 212, 255, 0.4);
  }

  time {
    color: #00d4ff;
    font-family: "JetBrains Mono", monospace;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .commit-msg {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.8rem;
    color: #ccc;
  }

  .cm-key {
    color: #c678dd;
  }

  .summary-content {
    align-items: flex-start;
  }

  .summary-content p {
    font-size: 0.8rem;
    line-height: 1.55;
    color: #888 !important;
    margin: 0;
    padding: 6px 0;
  }

  /* ── HEAD ── */
  .head-row {
    padding-top: 8px;
  }

  .head-dot {
    border-width: 3px;
    box-shadow: 0 0 12px rgba(0, 255, 159, 0.5);
  }

  .head-dot::after {
    animation: headPulse 2s ease-in-out infinite;
  }

  @keyframes headPulse {
    0%, 100% { transform: scale(1); opacity: 1; }
    50% { transform: scale(1.4); opacity: 0.6; }
  }

  .head-tag {
    font-size: 0.68rem;
    font-weight: 700;
    color: #0a0a0a;
    background: #00ff9f;
    padding: 2px 8px;
    border-radius: 4px;
    font-family: "JetBrains Mono", monospace;
  }

  .head-branch {
    font-size: 0.68rem;
    color: #00ff9f;
    border: 1px solid rgba(0, 255, 159, 0.4);
    padding: 2px 8px;
    border-radius: 4px;
    background: rgba(0, 255, 159, 0.08);
    font-family: "JetBrains Mono", monospace;
  }

  .head-msg {
    font-size: 0.72rem;
    color: #666;
    font-family: "JetBrains Mono", monospace;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .graph-body {
      padding: 20px 10px 15px;
    }

    .trunk-line {
      left: 18px;
    }

    .graph-col {
      width: 40px;
      min-width: 40px;
    }

    .main-dot {
      margin-left: 12px;
    }

    .branch-dot {
      margin-left: 28px;
    }

    /* Connectors — mobile positions */
    .fork-row .graph-col::after {
      left: 19px;
      width: 15px;
    }

    .branch-row .graph-col::before {
      left: 34px;
    }

    .last-branch .graph-col::after {
      left: 19px;
      width: 15px;
    }

    .dot {
      width: 12px;
      height: 12px;
    }

    .main-dot::after {
      width: 4px;
      height: 4px;
    }

    .dot-inner {
      width: 4px;
      height: 4px;
    }

    .commit-row {
      gap: 10px;
      min-height: 26px;
    }

    .hash { font-size: 0.6rem; }
    .branch-badge { font-size: 0.58rem; padding: 1px 6px; }
    .row-msg { font-size: 0.62rem; }
    .merge-tag { font-size: 0.6rem; }
    .commit-msg { font-size: 0.7rem; }

    .company-row {
      padding: 8px 10px;
      gap: 8px;
    }

    .company-logo img {
      height: 30px;
    }

    .company-row h3 {
      font-size: 0.85rem;
    }

    time {
      font-size: 0.65rem;
    }

    .summary-content p {
      font-size: 0.72rem;
    }

    .head-tag,
    .head-branch {
      font-size: 0.6rem;
    }

    .head-msg {
      font-size: 0.62rem;
    }
  }
</style>
