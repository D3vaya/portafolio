---
import Section from "../Section.astro"
import { education } from "@cv"

const sorted = [...education].sort(
  (a, b) => new Date(b.startDate).getTime() - new Date(a.startDate).getTime()
)

const accentColors = ["#00d4ff", "#c678dd", "#ffd700", "#ff006e", "#00ff9f"]

const getMonths = (start: string, end: string | undefined) => {
  const s = new Date(start)
  const e = end ? new Date(end) : new Date()
  return (e.getFullYear() - s.getFullYear()) * 12 + (e.getMonth() - s.getMonth())
}

// Deterministic PRNG
const mulberry32 = (seed: number) => {
  let s = seed | 0
  return () => {
    s = (s + 0x6D2B79F5) | 0
    let t = Math.imul(s ^ (s >>> 15), 1 | s)
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296
  }
}

// Each career gets a unique "study personality"
// — different peak positions, break zones, wave shape, intensity ceiling
interface StudyProfile {
  peaks: [number, number, number]   // 3 activity peak positions (0..1)
  peakWidth: number                 // how broad peaks are (higher = narrower)
  peakStrength: number              // 0..1 how much peaks boost
  breakZones: [number, number][]    // [start, end] quiet periods
  breakFloor: number                // min activity during breaks
  waveFreq: number                  // sine oscillation frequency
  waveAmp: number                   // sine amplitude
  baseLine: number                  // base activity level
  ceiling: number                   // max overall intensity
  weekendFactor: number             // weekend reduction (0..1)
}

const studyProfiles: StudyProfile[] = [
  // Profile 0 — Steady worker, dual exam peaks, clear breaks
  {
    peaks: [0.32, 0.72, 0.92],
    peakWidth: 9, peakStrength: 0.65,
    breakZones: [[0, 0.06], [0.48, 0.55]],
    breakFloor: 0.12,
    waveFreq: 6.5, waveAmp: 0.18, baseLine: 0.38,
    ceiling: 1.0, weekendFactor: 0.3,
  },
  // Profile 1 — Burst worker, intense mid-semester, long quiet stretches
  {
    peaks: [0.2, 0.55, 0.85],
    peakWidth: 12, peakStrength: 0.8,
    breakZones: [[0, 0.1], [0.38, 0.46], [0.68, 0.76]],
    breakFloor: 0.08,
    waveFreq: 4.2, waveAmp: 0.25, baseLine: 0.22,
    ceiling: 1.0, weekendFactor: 0.2,
  },
  // Profile 2 — Creative/consistent, many small peaks, rarely fully off
  {
    peaks: [0.15, 0.45, 0.78],
    peakWidth: 6, peakStrength: 0.45,
    breakZones: [[0.9, 1.0]],
    breakFloor: 0.2,
    waveFreq: 9.0, waveAmp: 0.12, baseLine: 0.42,
    ceiling: 0.88, weekendFactor: 0.5,
  },
]

// Generate full-width contribution grid (7 rows x 52 cols)
const getContributionGrid = (seed: number, profileIndex: number) => {
  const COLS = 52
  const rand = mulberry32(seed)
  const p = studyProfiles[profileIndex % studyProfiles.length]
  const grid: number[][] = []

  for (let col = 0; col < COLS; col++) {
    const week: number[] = []
    const t = col / COLS // 0..1

    // Peaks — gaussian bumps at profile-specific positions
    let peakBoost = 0
    for (const pk of p.peaks) {
      peakBoost = Math.max(peakBoost, Math.exp(-Math.pow((t - pk) * p.peakWidth, 2)))
    }

    // Break zones — reduce activity in quiet periods
    let breakFactor = 1
    for (const [zStart, zEnd] of p.breakZones) {
      if (t >= zStart && t <= zEnd) {
        breakFactor = Math.min(breakFactor, p.breakFloor)
      }
    }

    // Base sine wave
    const baseWave = p.baseLine + p.waveAmp * Math.sin(t * Math.PI * p.waveFreq)

    // Combined week intensity
    const weekIntensity = Math.min((baseWave + peakBoost * p.peakStrength) * breakFactor, p.ceiling)

    for (let row = 0; row < 7; row++) {
      const r = rand()

      const isWeekend = row === 0 || row === 6
      const dayFactor = isWeekend ? p.weekendFactor : 1

      const raw = weekIntensity * dayFactor * (0.25 + r * 0.95)

      let val: number
      if (raw < 0.16) val = 0
      else if (raw < 0.32) val = 1
      else if (raw < 0.52) val = 2
      else if (raw < 0.72) val = 3
      else val = 4

      week.push(val)
    }
    grid.push(week)
  }
  return grid
}

const getRepoName = (institution: string) =>
  institution.toLowerCase().replace(/[\s().]+/g, "-").replace(/-+$/, "").replace(/^-/, "")
---

<Section title="> education --github">
  <div class="gh-container" id="edu-github">
    {sorted.map((edu, i) => {
      const color = accentColors[i % accentColors.length]
      const startYear = new Date(edu.startDate).getFullYear()
      const endYear = edu.endDate ? new Date(edu.endDate).getFullYear() : "Present"
      const months = getMonths(edu.startDate, edu.endDate)
      const grid = getContributionGrid(i * 7919 + 42, i)
      const repo = getRepoName(edu.institution)

      return (
        <div class="gh-card" data-gh-card style={`--gh-accent: ${color}`}>
          {/* Header */}
          <div class="gh-card-header">
            <div class="gh-repo-icon">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M2 2.5A2.5 2.5 0 014.5 0h8.75a.75.75 0 01.75.75v12.5a.75.75 0 01-.75.75h-2.5a.75.75 0 010-1.5h1.75v-2h-8a1 1 0 00-.714 1.7.75.75 0 01-1.072 1.05A2.495 2.495 0 012 11.5v-9z" fill="currentColor" opacity="0.6"/>
              </svg>
            </div>
            <div class="gh-repo-info">
              <a href={edu.url} target="_blank" rel="noopener noreferrer" class="gh-repo-name">
                education/{repo}
              </a>
              <span class="gh-repo-visibility">Public</span>
            </div>
          </div>

          {/* Description */}
          <p class="gh-description">{edu.area}</p>

          {/* Badges */}
          <div class="gh-badges" data-gh-badges>
            <span class="gh-badge" style={`background: ${color}22; color: ${color}; border-color: ${color}44`}>
              {edu.studyType || "Degree"}
            </span>
            <span class="gh-badge gh-badge-year">
              {startYear} — {endYear}
            </span>
            <span class="gh-badge gh-badge-duration">
              {months} months
            </span>
          </div>

          {/* Contribution grid */}
          <div class="gh-contrib-section">
            <span class="gh-contrib-title">{startYear} — {endYear} · {months} months of contributions</span>
            <div class="gh-month-labels">
              {["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"].map(m => (
                <span class="gh-month-label">{m}</span>
              ))}
            </div>
            <div class="gh-contrib-grid" data-gh-grid>
              {grid.map((col) => (
                <div class="gh-contrib-col">
                  {col.map((val) => (
                    <div
                      class={`gh-contrib-cell gh-c-${val}`}
                      style={`--gh-accent: ${color}`}
                      data-gh-cell
                    ></div>
                  ))}
                </div>
              ))}
            </div>
            <div class="gh-contrib-legend">
              <span class="gh-contrib-legend-label">Less</span>
              {[0, 1, 2, 3, 4].map((val) => (
                <div
                  class={`gh-contrib-cell gh-c-${val}`}
                  style={`--gh-accent: ${color}`}
                ></div>
              ))}
              <span class="gh-contrib-legend-label">More</span>
            </div>
          </div>

          {/* Stats row */}
          <div class="gh-stats">
            <div class="gh-stat">
              <span class="gh-stat-icon" style={`background: ${color}`}></span>
              <span class="gh-stat-label">{edu.area}</span>
            </div>
            <div class="gh-stat">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="#ffd700">
                <path d="M8 .25a.75.75 0 01.673.418l1.882 3.815 4.21.612a.75.75 0 01.416 1.279l-3.046 2.97.719 4.192a.75.75 0 01-1.088.791L8 12.347l-3.766 1.98a.75.75 0 01-1.088-.79l.72-4.194L.818 6.374a.75.75 0 01.416-1.28l4.21-.611L7.327.668A.75.75 0 018 .25z"/>
              </svg>
              <span class="gh-stat-label">{edu.score || "4.0"}</span>
            </div>
            <div class="gh-stat">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="#666">
                <path d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878z"/>
              </svg>
              <span class="gh-stat-label">{edu.courses?.length || 1} courses</span>
            </div>
          </div>
        </div>
      )
    })}
  </div>
</Section>

<script>
  import { gsap, prefersReducedMotion } from "@/scripts/gsap-init";

  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("edu-github");
    if (!container) return;

    const cards = container.querySelectorAll("[data-gh-card]");
    const cells = container.querySelectorAll("[data-gh-cell]");

    if (prefersReducedMotion()) {
      cards.forEach(el => {
        (el as HTMLElement).style.opacity = "1";
        (el as HTMLElement).style.visibility = "visible";
      });
      return;
    }

    // Cards stagger in
    gsap.fromTo(cards,
      { autoAlpha: 0, y: 25, scale: 0.97 },
      {
        autoAlpha: 1,
        y: 0,
        scale: 1,
        stagger: 0.2,
        duration: 0.5,
        ease: "power3.out",
        scrollTrigger: {
          trigger: container,
          start: "top 80%",
          toggleActions: "play none none none",
        },
      }
    );

    // Contribution cells fill stagger
    cards.forEach((card) => {
      const cardCells = card.querySelectorAll("[data-gh-cell]");
      gsap.fromTo(cardCells,
        { scale: 0 },
        {
          scale: 1,
          stagger: {
            each: 0.015,
            from: "start",
          },
          duration: 0.2,
          ease: "back.out(2)",
          scrollTrigger: {
            trigger: card,
            start: "top 75%",
            toggleActions: "play none none none",
          },
          delay: 0.4,
        }
      );
    });

    // Badges stagger
    cards.forEach((card) => {
      const badges = card.querySelectorAll("[data-gh-badges] .gh-badge");
      gsap.fromTo(badges,
        { autoAlpha: 0, y: 8 },
        {
          autoAlpha: 1,
          y: 0,
          stagger: 0.1,
          duration: 0.3,
          ease: "power2.out",
          scrollTrigger: {
            trigger: card,
            start: "top 80%",
            toggleActions: "play none none none",
          },
          delay: 0.3,
        }
      );
    });
  });
</script>

<style>
  .gh-container {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Card */
  .gh-card {
    background: rgba(22, 27, 34, 0.92);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 20px;
    backdrop-filter: blur(10px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .gh-card:hover {
    border-color: var(--gh-accent);
    box-shadow: 0 0 20px color-mix(in srgb, var(--gh-accent) 15%, transparent);
  }

  /* Header */
  .gh-card-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
  }

  .gh-repo-icon {
    color: #888;
  }

  .gh-repo-info {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .gh-repo-name {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--gh-accent) !important;
    text-decoration: none !important;
  }

  .gh-repo-name:hover {
    text-decoration: underline !important;
    color: var(--gh-accent) !important;
    text-shadow: 0 0 8px var(--gh-accent) !important;
  }

  .gh-repo-visibility {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.6rem;
    color: #666;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1px 8px;
    border-radius: 12px;
  }

  /* Description */
  .gh-description {
    font-size: 0.82rem !important;
    color: #999 !important;
    margin-bottom: 12px !important;
    line-height: 1.4 !important;
  }

  /* Badges */
  .gh-badges {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .gh-badge {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.62rem;
    padding: 3px 10px;
    border-radius: 12px;
    border: 1px solid;
    font-weight: 600;
  }

  .gh-badge-year {
    background: rgba(255, 215, 0, 0.08) !important;
    color: #ffd700 !important;
    border-color: rgba(255, 215, 0, 0.25) !important;
  }

  .gh-badge-duration {
    background: rgba(0, 255, 159, 0.08) !important;
    color: #00ff9f !important;
    border-color: rgba(0, 255, 159, 0.25) !important;
  }

  /* Month labels */
  .gh-month-labels {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4px;
    padding: 0 1px;
  }

  .gh-month-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5rem;
    color: #444;
    flex: 1;
    text-align: center;
  }

  /* Contribution grid */
  .gh-contrib-section {
    margin-bottom: 14px;
    padding: 12px;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.04);
  }

  .gh-contrib-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    color: #666;
    display: block;
    margin-bottom: 8px;
  }

  .gh-contrib-grid {
    display: flex;
    gap: 2px;
    width: 100%;
    overflow: hidden;
  }

  .gh-contrib-col {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .gh-contrib-cell {
    aspect-ratio: 1;
    width: 100%;
    border-radius: 2px;
  }

  .gh-c-0 { background: rgba(255, 255, 255, 0.04); }
  .gh-c-1 { background: color-mix(in srgb, var(--gh-accent) 20%, transparent); }
  .gh-c-2 { background: color-mix(in srgb, var(--gh-accent) 40%, transparent); }
  .gh-c-3 { background: color-mix(in srgb, var(--gh-accent) 65%, transparent); }
  .gh-c-4 { background: var(--gh-accent); }

  .gh-contrib-legend {
    display: flex;
    align-items: center;
    gap: 3px;
    margin-top: 8px;
    justify-content: flex-end;
  }

  .gh-contrib-legend .gh-contrib-cell {
    width: 10px;
    height: 10px;
    flex: none;
    aspect-ratio: auto;
  }

  .gh-contrib-legend-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.55rem;
    color: #555;
    margin: 0 4px;
  }

  /* Stats */
  .gh-stats {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .gh-stat {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .gh-stat-icon {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .gh-stat-label {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.68rem;
    color: #888;
  }

  .gh-stat svg {
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .gh-card {
      padding: 14px;
    }

    .gh-repo-name {
      font-size: 0.78rem;
    }

    .gh-contrib-grid {
      gap: 1px;
    }

    .gh-contrib-col {
      gap: 1px;
    }

    .gh-stats {
      gap: 10px;
    }

    .gh-stat-label {
      font-size: 0.62rem;
    }

    .gh-badges {
      gap: 6px;
    }
  }
</style>
