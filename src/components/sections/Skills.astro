---
import Section from "../Section.astro"
import { skills } from "@cv"

const skillCategories: Record<string, string[]> = {
  "Frontend": ["HTML", "CSS", "JavaScript", "TypeScript", "React", "Next.js", "Next JS", "Tailwind", "Gatsby JS", "Angular", "Vue JS", "Svelte", "Astro", "GraphQL"],
  "Backend": ["Node Js", "Express", "MySQL", "PostgreSQL", "Firebase", "Supabase", "PHP", "Cake PHP", "Laravel", "Java", "Elixir", "Phoenix Framework", "Go", "MongoDB", "Redis"],
  "Tools": ["Git", "GitHub", "Figma", "AWS Lambda", "AWS EC2", "AWS S3", "AWS ELB / ASG"]
}

// Hero skills - prominent
const heroSkills = ["React", "Next.js", "Next JS", "TypeScript"]

const getLevelPercent = (level: string): number => {
  const percents: Record<string, number> = {
    'Beginner': 25,
    'Medio': 50,
    'Intermediate': 50,
    'Avanzado': 75,
    'Advanced': 75,
    'Expert': 90,
    'Master': 100,
  }
  return percents[level] || 60
}

const getProficiencyColor = (level: string): string => {
  const colors: Record<string, string> = {
    'Beginner': '#ff006e',
    'Medio': '#ff6b35',
    'Intermediate': '#ff6b35',
    'Avanzado': '#ffd700',
    'Advanced': '#ffd700',
    'Expert': '#00ff9f',
    'Master': '#00d4ff',
  }
  return colors[level] || '#00ff9f'
}
---

<Section title="> skills --list">
  <div class="skills-power-grid" id="skills-grid">
    {Object.entries(skillCategories).map(([category, categorySkills]) => {
      const matchedSkills = skills.filter(s => categorySkills.includes(s.name))
      if (matchedSkills.length === 0) return null

      return (
        <div class="skill-category" data-skill-cat>
          <div class="category-header" data-skill-header>
            <span class="prompt">$ ls {category.toLowerCase()}/</span>
            <div class="category-badge">{matchedSkills.length} modules</div>
          </div>
          <div class="skills-grid">
            {matchedSkills.map((skill) => {
              const color = getProficiencyColor(skill.level || "Expert")
              const percent = getLevelPercent(skill.level || "Expert")
              const isHero = heroSkills.includes(skill.name)

              return (
                <div
                  class={`skill-chip ${isHero ? "hero-skill" : ""}`}
                  style={`--skill-color: ${color}; --skill-pct: ${percent}%`}
                  data-level={skill.level || "Expert"}
                  data-skill-chip
                >
                  <span class="skill-name">{skill.name}</span>
                  <div class="skill-level-bar">
                    <div class="skill-level-fill" data-skill-bar></div>
                  </div>
                  <span class="skill-level-label">{skill.level}</span>
                </div>
              )
            })}
          </div>
        </div>
      )
    })}
  </div>
</Section>

<script>
  import { gsap, prefersReducedMotion } from "@/scripts/gsap-init";

  document.addEventListener("DOMContentLoaded", () => {
    if (prefersReducedMotion()) {
      document.querySelectorAll("[data-skill-chip]").forEach(el => {
        const htmlEl = el as HTMLElement;
        htmlEl.style.opacity = "1";
        htmlEl.style.visibility = "visible";
        htmlEl.style.transform = "none";
      });
      document.querySelectorAll("[data-skill-bar]").forEach(el => {
        (el as HTMLElement).style.transform = "scaleX(1)";
      });
      return;
    }

    // Category headers clip-path reveal
    document.querySelectorAll("[data-skill-header]").forEach((header) => {
      gsap.fromTo(header,
        { clipPath: "inset(0 100% 0 0)" },
        {
          clipPath: "inset(0 0% 0 0)",
          duration: 0.6,
          ease: "power3.inOut",
          scrollTrigger: {
            trigger: header,
            start: "top 85%",
            toggleActions: "play none none none",
          },
        }
      );
    });

    // Skill chips stagger from random positions
    document.querySelectorAll("[data-skill-cat]").forEach((cat) => {
      const chips = cat.querySelectorAll("[data-skill-chip]");
      // Set initial state explicitly
      gsap.set(chips, { scale: 0, autoAlpha: 0 });
      gsap.to(chips, {
        scale: 1,
        autoAlpha: 1,
        stagger: {
          each: 0.08,
          from: "random",
        },
        duration: 0.4,
        ease: "back.out(1.7)",
        scrollTrigger: {
          trigger: cat,
          start: "top 85%",
          toggleActions: "play none none none",
        },
      });
    });

    // Level bars fill with ScrollTrigger
    document.querySelectorAll("[data-skill-bar]").forEach((bar) => {
      gsap.fromTo(bar,
        { scaleX: 0 },
        {
          scaleX: 1,
          duration: 0.8,
          ease: "power2.out",
          scrollTrigger: {
            trigger: bar,
            start: "top 85%",
            toggleActions: "play none none none",
          },
        }
      );
    });

    // Hero skills pulse glow
    gsap.to(".hero-skill", {
      boxShadow: "0 0 25px rgba(0, 255, 159, 0.4), 0 0 50px rgba(0, 255, 159, 0.2)",
      repeat: -1,
      yoyo: true,
      duration: 2,
      ease: "sine.inOut",
      scrollTrigger: {
        trigger: "#skills-grid",
        start: "top 60%",
        toggleActions: "play pause resume pause",
      },
    });
  });
</script>

<style>
  .skills-power-grid {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .skill-category {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(0, 255, 159, 0.15);
    border-radius: 12px;
    padding: 20px;
    backdrop-filter: blur(10px);
  }

  .category-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(0, 255, 159, 0.2);
  }

  .prompt {
    color: #ff006e;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .category-badge {
    background: rgba(0, 255, 159, 0.1);
    color: #00ff9f;
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 0.7rem;
    font-family: 'JetBrains Mono', monospace;
    border: 1px solid rgba(0, 255, 159, 0.3);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .skill-chip {
    position: relative;
    background: rgba(26, 26, 46, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
    padding: 10px 16px;
    cursor: default;
    transition: all 0.3s ease;
    min-width: 100px;
    backdrop-filter: blur(5px);
    display: flex;
    flex-direction: column;
    gap: 6px;
    /* Visible by default - GSAP will handle hide/reveal */
    visibility: visible;
  }

  .skill-chip.hero-skill {
    border-color: rgba(0, 255, 159, 0.4);
    background: rgba(0, 255, 159, 0.08);
    min-width: 140px;
    padding: 14px 20px;
  }

  .skill-chip:hover {
    transform: translateY(-3px);
    border-color: var(--skill-color, #00ff9f);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .skill-chip:hover .skill-level-label {
    opacity: 1;
  }

  .skill-name {
    color: var(--skill-color, #00ff9f);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .hero-skill .skill-name {
    font-size: 0.95rem;
    text-shadow: 0 0 8px var(--skill-color, #00ff9f);
  }

  .skill-level-bar {
    width: 100%;
    height: 3px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
  }

  .skill-level-fill {
    width: var(--skill-pct, 60%);
    height: 100%;
    background: var(--skill-color, #00ff9f);
    border-radius: 2px;
    transform-origin: left;
    box-shadow: 0 0 6px var(--skill-color, #00ff9f);
  }

  .skill-level-label {
    font-size: 0.65rem;
    color: #666;
    font-family: 'JetBrains Mono', monospace;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .skill-category {
      padding: 15px;
    }

    .skills-grid {
      gap: 8px;
    }

    .skill-chip {
      min-width: 80px;
      padding: 8px 12px;
    }

    .skill-chip.hero-skill {
      min-width: 110px;
      padding: 10px 14px;
    }

    .skill-name {
      font-size: 0.72rem;
    }

    .hero-skill .skill-name {
      font-size: 0.8rem;
    }

    .prompt {
      font-size: 0.75rem;
    }

    .skill-level-label {
      opacity: 1;
    }
  }
</style>
