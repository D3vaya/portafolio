---
import Section from "../Section.astro"
import { basics } from "@cv"
const { summary } = basics
---

<Section title="About">
  <div class="code-editor" id="about-editor">
    <div class="editor-header">
      <div class="editor-tabs">
        <div class="tab active" data-tab>about.ts</div>
        <div class="tab" data-tab>skills.json</div>
        <div class="tab" data-tab>experience.md</div>
      </div>
    </div>
    <div class="editor-content">
      <div class="line-numbers">
        {Array.from({ length: 14 }, (_, i) => (
          <span data-ln>{i + 1}</span>
        ))}
      </div>
      <div class="code-content">
        <div class="code-line" data-code-line><span class="comment">// Developer Profile</span></div>
        <div class="code-line" data-code-line><span class="keyword">interface</span> <span class="variable">Developer</span> {"{"}</div>
        <div class="code-line" data-code-line>  <span class="property">role</span>: <span class="type">string</span>;</div>
        <div class="code-line" data-code-line>  <span class="property">experience</span>: <span class="type">number</span>;</div>
        <div class="code-line" data-code-line>  <span class="property">summary</span>: <span class="type">string</span>;</div>
        <div class="code-line" data-code-line>{"}"}</div>
        <div class="code-line" data-code-line>&nbsp;</div>
        <div class="code-line" data-code-line><span class="keyword">const</span> <span class="variable">me</span>: <span class="type">Developer</span> = {"{"}</div>
        <div class="code-line" data-code-line>  <span class="property">role</span>: <span class="string">"Tech Lead Frontend"</span>,</div>
        <div class="code-line" data-code-line>  <span class="property">experience</span>: <span class="number">12</span>,</div>
        <div class="code-line summary-line" data-code-line>  <span class="property">summary</span>: <span class="string">"{summary}"</span>,</div>
        <div class="code-line" data-code-line>{"}"};</div>
        <div class="code-line" data-code-line>&nbsp;</div>
        <div class="code-line" data-code-line><span class="comment">// Ready to build something amazing</span></div>
      </div>
      <div class="glow-line" id="glow-line"></div>
    </div>
  </div>
</Section>

<script>
  import { gsap, prefersReducedMotion } from "@/scripts/gsap-init";

  document.addEventListener("DOMContentLoaded", () => {
    if (prefersReducedMotion()) return;

    const editor = document.getElementById("about-editor");
    if (!editor) return;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: editor,
        start: "top 80%",
        toggleActions: "play none none none",
      },
    });

    // Editor container scales in
    tl.from(editor, {
      scale: 0.95,
      opacity: 0,
      y: 50,
      duration: 0.6,
      ease: "power3.out",
    });

    // Tabs stagger
    tl.from("[data-tab]", {
      y: -20,
      opacity: 0,
      stagger: 0.1,
      duration: 0.3,
    }, "-=0.3");

    // Line numbers stagger
    tl.from("[data-ln]", {
      x: -20,
      opacity: 0,
      stagger: 0.03,
      duration: 0.2,
    }, "-=0.2");

    // Code lines stagger
    tl.from("[data-code-line]", {
      x: -30,
      opacity: 0,
      stagger: 0.05,
      duration: 0.3,
    }, "-=0.2");

    // Glow line sweep animation
    const glowLine = document.getElementById("glow-line");
    if (glowLine) {
      const codeLines = editor.querySelectorAll("[data-code-line]");
      const lineHeight = 28;
      gsap.to(glowLine, {
        y: (codeLines.length - 1) * lineHeight,
        duration: 4,
        repeat: -1,
        ease: `steps(${codeLines.length})`,
        scrollTrigger: {
          trigger: editor,
          start: "top 60%",
          toggleActions: "play pause resume pause",
        },
      });
    }
  });
</script>

<style>
  .code-editor {
    background: #1a1a2e;
    border: 1px solid rgba(0, 255, 159, 0.3);
    border-radius: 10px;
    overflow: hidden;
    font-family: 'JetBrains Mono', monospace;
    box-shadow:
      0 10px 40px rgba(0, 0, 0, 0.5),
      0 0 20px rgba(0, 255, 159, 0.1);
  }

  .editor-header {
    background: rgba(0, 0, 0, 0.5);
    border-bottom: 1px solid rgba(0, 255, 159, 0.2);
  }

  .editor-tabs {
    display: flex;
  }

  .tab {
    padding: 10px 18px;
    color: #666;
    background: transparent;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .tab.active {
    background: #1a1a2e;
    color: #00ff9f;
    border-bottom: 2px solid #00ff9f;
  }

  .tab:hover:not(.active) {
    background: rgba(255, 255, 255, 0.05);
    color: #aaa;
  }

  .editor-content {
    display: flex;
    min-height: 150px;
    position: relative;
  }

  .line-numbers {
    background: rgba(0, 0, 0, 0.3);
    padding: 15px 12px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    display: flex;
    flex-direction: column;
    font-size: 0.8rem;
    color: #555;
    user-select: none;
    min-width: 45px;
    text-align: right;
    line-height: 1.75;
  }

  .code-content {
    padding: 15px 20px;
    flex: 1;
    font-size: 0.85rem;
    line-height: 1.75;
    overflow-x: auto;
  }

  .code-line {
    white-space: nowrap;
    position: relative;
  }

  .glow-line {
    position: absolute;
    left: 45px;
    top: 15px;
    right: 0;
    height: 28px;
    background: rgba(0, 255, 159, 0.04);
    border-left: 2px solid rgba(0, 255, 159, 0.3);
    pointer-events: none;
  }

  .keyword { color: #c678dd; font-weight: 500; }
  .variable { color: #61afef; }
  .property { color: #e5c07b; }
  .string { color: #98c379; }
  .comment { color: #5c6370; font-style: italic; }
  .type { color: #e06c75; }
  .number { color: #d19a66; }

  .code-line:hover {
    background: rgba(0, 255, 159, 0.05);
  }

  .summary-line .string {
    white-space: normal;
    display: inline;
    word-break: break-word;
  }

  @media (max-width: 768px) {
    .code-content {
      padding: 10px 12px;
      font-size: 0.72rem;
      line-height: 1.6;
    }

    .line-numbers {
      min-width: 35px;
      padding: 10px 8px;
      font-size: 0.7rem;
      line-height: 1.6;
    }

    .tab {
      padding: 8px 12px;
      font-size: 0.7rem;
    }

    .glow-line {
      display: none;
    }

    .code-editor {
      margin: 0 -5px;
      border-radius: 8px;
    }
  }
</style>
