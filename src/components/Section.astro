---
const { title } = Astro.props
---

<section>
  {title && <h2>{title}</h2>}
  <slot />
</section>

<style>
  section {
    max-width: 800px;
    margin: 0 auto 48px;
    position: relative;
  }

  h2 {
    margin-bottom: 24px;
    font-weight: 700;
    line-height: 1.4;
    font-size: 1.6rem;
    color: #ffffff;
    text-shadow:
      0 0 10px rgba(0, 255, 159, 0.3),
      0 0 20px rgba(0, 255, 159, 0.15);
    font-family: 'Space Grotesk', sans-serif;
    letter-spacing: 1px;
    position: relative;
    padding-bottom: 12px;
  }

  h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 50px;
    height: 2px;
    background: linear-gradient(90deg, #00ff9f, #00d4ff);
    border-radius: 2px;
    box-shadow: 0 0 8px rgba(0, 255, 159, 0.4);
  }

  @media (max-width: 768px) {
    section {
      margin-bottom: 32px;
    }

    h2 {
      font-size: 1.3rem;
    }
  }
</style>
