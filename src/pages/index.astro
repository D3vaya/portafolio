---
import Layout from "@/layouts/Layout.astro"
import Hero from "@/components/Hero.astro"
import Measure from "@/components/Measure.astro"
import Trace from "@/components/Trace.astro"
import Harness from "@/components/Harness.astro"
import Products from "@/components/Products.astro"
import About from "@/components/About.astro"
import Stack from "@/components/Stack.astro"
import Learning from "@/components/Learning.astro"
import Contact from "@/components/Contact.astro"
import Analytics from "@vercel/analytics/astro"
import { basics, work } from "@cv"
import { yearsSince } from "@/lib/time"

const firstJob = work.reduce((a, b) => (a.startDate < b.startDate ? a : b))
const description =
  `Ingeniero de harnesses para agentes de IA y tech lead con ${yearsSince(firstJob.startDate)} años en producción. Líder de desarrollo en Porteria; creador de Monoke y Carcassonne Latam.`

const nav = [
  { href: "#harness", label: "Harness" },
  { href: "#productos", label: "Productos" },
  { href: "#trayectoria", label: "Trayectoria" },
  { href: "#contacto", label: "Contacto" },
]
---

<Layout title={`${basics.name}, AI harness engineer`} description={description}>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <header class="wrap top">
    <a class="home" href="/">jcayala.dev</a>
    <nav aria-label="Secciones">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
  </header>
  <main id="contenido" tabindex="-1">
    <Hero />
    <Measure />
    <Harness />
    <Products />
    <Trace />
    <About />
    <Stack />
    <Learning />
  </main>
  <Contact />
  <Analytics />
</Layout>

<style>
  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 1.25rem;
    font-size: 0.9375rem;
  }

  .home {
    font-family: var(--display);
    font-weight: 800;
    font-stretch: 80%;
    text-decoration: none;
  }

  .top ul {
    display: flex;
    gap: 1.5rem;
  }

  .top nav a {
    text-decoration: none;
  }

  .top nav a:hover {
    text-decoration: underline;
    text-decoration-color: var(--senal);
  }

  .skip {
    position: absolute;
    left: 1rem;
    top: -4rem;
    padding: 0.5rem 1rem;
    background: var(--senal);
    color: var(--sobre);
    z-index: 10;
  }

  .skip:focus {
    top: 1rem;
  }

  @media (max-width: 36rem) {
    .top nav {
      display: none;
    }
  }
</style>
