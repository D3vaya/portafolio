---
/*
  Tarjeta de una guía en la biblioteca: una placa de grafito con la grilla de puntos, un circuito
  que dibuja de qué trata la guía y una señal que lo recorre. Es la misma pieza visual que las
  animaciones dentro de las guías.
*/
import type { Guide } from "../data/guides";

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const live = guide.status === "publicada";
const cc = guide.slug === "claude-code";
const Tag = live ? "a" : "div";
---

<Tag class:list={["gboard", !live && "is-soon"]} href={live ? `/${guide.slug}/` : undefined} style={`--sig:${guide.signal}`}>
  <span class="gb-pill"><i></i>{live ? "Guía" : "En preparación"}</span>
  <svg class="gb-art" viewBox="0 0 320 150" aria-hidden="true">
    {
      cc ? (
        <g>
          {/* tú → harness → herramientas: el loop de Claude Code */}
          <path class="tr" d="M30 75 H110 M210 75 H290 M160 45 V18 H250 M160 105 V132 H250" />
          <path class="tr sig-path" id={`p-${guide.slug}`} d="M30 75 H110 M110 75 H210 M210 75 H290" />
          <rect class="chip" x="110" y="45" width="100" height="60" rx="10" />
          <text x="160" y="80" class="chip-t">harness</text>
          <circle class="pad" cx="30" cy="75" r="7" />
          <circle class="pad" cx="290" cy="75" r="7" />
          <circle class="pad" cx="250" cy="18" r="5" />
          <circle class="pad" cx="250" cy="132" r="5" />
          <text x="30" y="100" class="lbl">tú</text>
          <text x="304" y="100" class="lbl r">herramientas</text>
          <text x="262" y="22" class="lbl l">memoria</text>
          <text x="262" y="136" class="lbl l">hooks</text>
        </g>
      ) : (
        <g>
          {/* una rama que se separa y vuelve: el grafo de commits */}
          <path class="tr" d="M20 95 H300" />
          <path class="tr" d="M80 95 C110 95 110 45 140 45 H220 C250 45 250 95 280 95" />
          <path class="tr sig-path" d="M20 95 H80 C110 95 110 45 140 45 H220 C250 45 250 95 280 95 H300" />
          {[20, 80, 160, 220, 280].map((x) => <circle class="pad" cx={x} cy="95" r="6" />)}
          {[140, 180, 220].map((x) => <circle class="pad" cx={x} cy="45" r="6" />)}
          <text x="20" y="122" class="lbl">main</text>
          <text x="180" y="28" class="lbl">feature</text>
        </g>
      )
    }
    {live && <circle class="sig" r="5"><animateMotion dur="3.6s" repeatCount="indefinite" path={cc ? "M30 75 H290" : "M20 95 H80 C110 95 110 45 140 45 H220 C250 45 250 95 280 95 H300"} /></circle>}
  </svg>
  <span class="gb-title">{guide.title}</span>
  <span class="gb-sub">{guide.tagline}</span>
  {live && <span class="gb-facts">{guide.facts.join(" · ")}</span>}
</Tag>

<style>
  .gboard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 22px;
    border-radius: 18px;
    color: #ececee;
    text-decoration: none;
    background-color: #111216;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.2px);
    background-size: 18px 18px;
    border: 1px solid #23252c;
    box-shadow: 0 24px 48px -26px rgb(0 0 0 / 0.55);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.3s;
    overflow: hidden;
  }
  a.gboard:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--sig) 55%, #23252c);
    box-shadow: 0 30px 56px -26px rgb(0 0 0 / 0.6), 0 0 0 1px color-mix(in srgb, var(--sig) 30%, transparent), 0 0 40px -18px var(--sig);
  }
  .gb-pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font: 500 12px var(--sans);
    color: #a8abb4;
    padding: 5px 10px;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
  }
  .gb-pill i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sig);
    box-shadow: 0 0 10px var(--sig);
  }
  .gb-art {
    width: 100%;
    height: auto;
    margin: 6px 0 4px;
  }
  .gb-art :global(.tr) {
    fill: none;
    stroke: rgb(255 255 255 / 0.16);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .gb-art :global(.sig-path) {
    stroke: color-mix(in srgb, var(--sig) 55%, transparent);
    stroke-dasharray: 6 10;
    animation: gb-flow 1.6s linear infinite;
  }
  .gb-art :global(.chip) {
    fill: #1b1d23;
    stroke: color-mix(in srgb, var(--sig) 70%, transparent);
    stroke-width: 1.5;
  }
  .gb-art :global(.chip-t) {
    fill: #ececee;
    font: 800 15px var(--display);
    font-stretch: 85%;
    text-anchor: middle;
  }
  .gb-art :global(.pad) {
    fill: #111216;
    stroke: var(--sig);
    stroke-width: 2;
  }
  .gb-art :global(.lbl) {
    fill: #8b8f99;
    font: 500 11px var(--sans);
    text-anchor: middle;
  }
  .gb-art :global(.lbl.l) {
    text-anchor: start;
  }
  .gb-art :global(.lbl.r) {
    text-anchor: end;
  }
  .gb-art :global(.sig) {
    fill: var(--sig);
    filter: drop-shadow(0 0 6px var(--sig));
  }
  @keyframes gb-flow {
    to {
      stroke-dashoffset: -32;
    }
  }
  .gb-title {
    font: 900 clamp(36px, 4vw, 52px)/0.9 var(--display);
    font-stretch: 72%;
    letter-spacing: -0.015em;
    margin-top: 6px;
  }
  .gb-sub {
    font: 400 16px/1.45 var(--sans);
    color: #b9bcc4;
    max-width: 28ch;
  }
  .gb-facts {
    font: 500 13px var(--sans);
    color: #7a7e89;
    margin-top: 6px;
  }
  .is-soon {
    background-color: transparent;
    background-image: none;
    border: 1.5px dashed var(--rule-2);
    box-shadow: none;
    color: var(--ink);
  }
  .is-soon .gb-pill {
    color: var(--ink-3);
    border-color: var(--rule-2);
  }
  .is-soon .gb-sub {
    color: var(--ink-2);
  }
  .is-soon .gb-art :global(.tr) {
    stroke: var(--rule-2);
  }
  .is-soon .gb-art :global(.pad) {
    fill: var(--paper);
  }
  .is-soon .gb-art :global(.lbl) {
    fill: var(--ink-3);
  }
  @media (prefers-reduced-motion: reduce) {
    .gb-art :global(.sig-path) {
      animation: none;
    }
    .gb-art :global(.sig) {
      display: none;
    }
  }
</style>
