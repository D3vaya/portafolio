---
import Base from "../layouts/Base.astro";
import ReaderMenu from "../components/ReaderMenu.astro";
import Colophon from "../components/Colophon.astro";
import GuideBoard from "../components/GuideBoard.astro";
import { guides } from "../data/guides";

const featured = guides.find((g) => g.status === "publicada")!;
const site = Astro.site!;
const author = { "@type": "Person", name: "Juan Carlos Ayala Higuera", url: "https://www.jcayala.dev/" };
const live = guides.filter((g) => g.status === "publicada");
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Guías · Juan Carlos Ayala",
    url: site.href,
    inLanguage: "es",
    author,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Guías publicadas",
    itemListElement: live.map((g, i) => ({
      "@type": "ListItem",
      position: i + 1,
      url: new URL(`/${g.slug}/`, site).href,
      name: g.title,
    })),
  },
];
const tracked = guides.filter((g) => g.progress).map((g) => ({ slug: g.slug, title: g.title, ...g.progress! }));
// La ruta de la guía destacada, dibujada como pista de circuito (coordenadas del SVG del hero)
const levels = [
  // lx/ly/anchor: la etiqueta va donde no pasa la pista, para que la señal no la tape
  { name: "Básico", desc: "primeros pasos", x: 40, y: 250, lx: 22, ly: -30, anchor: "start" },
  { name: "Intermedio", desc: "flujo de trabajo", x: 150, y: 180, lx: 22, ly: -30, anchor: "start" },
  { name: "Avanzado", desc: "hooks, skills, MCP", x: 270, y: 110, lx: -22, ly: -30, anchor: "end" },
  { name: "Experto", desc: "equipo y CI", x: 380, y: 40, lx: -24, ly: 0, anchor: "end" },
];
---

<Base
  title="Guías de desarrollo en español: Claude Code, Git y más"
  description="Guías gratuitas en español para aprender herramientas de desarrollo desde cero: Claude Code, Git y más, con animaciones y simuladores en el navegador."
  jsonLd={jsonLd}
>
  <header class="readerbar">
    <div class="row">
      <nav class="crumbs" aria-label="Ruta">
        <a href="https://www.jcayala.dev">jcayala.dev</a><span class="sep">/</span><span class="here">Guías</span>
      </nav>
      <div class="bar-actions"><ReaderMenu /></div>
    </div>
  </header>

  <main>
    <!-- ================= hero: título + la ruta de la guía como circuito ================= -->
    <section class="hero">
      <div class="hero-copy">
        <span class="pill"><i></i>{live.length === 1 ? "1 guía publicada" : `${live.length} guías publicadas`} · en español · gratis</span>
        <h1>Guías</h1>
        <p class="subtitle">
          Herramientas de desarrollo explicadas desde cero, con animaciones que muestran lo que pasa por dentro y
          simuladores para practicar en el navegador.
        </p>
        <div class="cta">
          <a class="btn pri" href={`/${featured.slug}/`}>Leer {featured.title}</a>
          <a class="btn" href="#biblioteca">Ver la biblioteca</a>
        </div>
      </div>

      <a class="route" href={`/${featured.slug}/`} aria-label={`Abrir la guía de ${featured.title}`}>
        <span class="route-head"><span class="pill dark"><i></i>Guía</span><b>{featured.title}</b></span>
        <svg viewBox="0 0 420 330" aria-hidden="true">
          <path class="trace" d="M40 300 V250 H150 V180 H270 V110 H380 V40" />
          <path class="trace lit" d="M40 300 V250 H150 V180 H270 V110 H380 V40" />
          {
            levels.map((l, i) => (
              <g class="lvl" style={`--d:${i * 0.9}s`}>
                <circle class="pad" cx={l.x} cy={l.y} r="13" />
                <circle class="core" cx={l.x} cy={l.y} r="5" />
                <text class="n" x={l.x + l.lx} y={l.y + l.ly - 4} text-anchor={l.anchor}>{l.name}</text>
                <text class="d" x={l.x + l.lx} y={l.y + l.ly + 14} text-anchor={l.anchor}>{l.desc}</text>
              </g>
            ))
          }
          <circle class="sig" r="6">
            <animateMotion dur="3.6s" repeatCount="indefinite" keyPoints="0;1;1" keyTimes="0;0.85;1" calcMode="linear" path="M40 300 V250 H150 V180 H270 V110 H380 V40" />
          </circle>
        </svg>
        <span class="route-foot">{featured.facts.join(" · ")}</span>
      </a>
    </section>

    <!-- ================= seguir leyendo (solo si hay progreso guardado) ================= -->
    <section class="resume" hidden data-resume={JSON.stringify(tracked)}>
      <span class="resume-label">Seguir leyendo</span>
      <a class="resume-card" href="#">
        <span class="resume-title"></span>
        <span class="resume-track"><b></b></span>
        <span class="resume-pct"></span>
      </a>
    </section>

    <!-- ================= biblioteca ================= -->
    <section class="library" id="biblioteca" aria-labelledby="lib-h">
      <div class="sec-head">
        <h2 id="lib-h">Biblioteca</h2>
        <p>Una guía por herramienta, de lo básico a lo que necesitas para usarla en equipo.</p>
      </div>
      <ul class="boards">
        {guides.map((g) => <li><GuideBoard guide={g} /><p class="board-sum">{g.summary}</p></li>)}
      </ul>
    </section>

    <!-- ================= cómo son las guías ================= -->
    <section class="how" aria-labelledby="how-h">
      <div class="sec-head">
        <h2 id="how-h">Cómo son las guías</h2>
      </div>
      <div class="how-grid">
        <div class="how-item">
          <div class="how-fig fig-anim" aria-hidden="true">
            <span class="fa-row"><i class="r"></i><i class="r"></i><i class="r"></i><i class="w"></i></span>
            <span class="fa-row cache"><i></i><i></i><i></i><i></i></span>
            <span class="fa-beam"></span>
          </div>
          <h3>Ves lo que pasa por dentro</h3>
          <p>Animaciones paso a paso para lo difícil de entender: el caché, el contexto, los subagentes. Avanzan solas o a tu ritmo.</p>
        </div>
        <div class="how-item">
          <div class="how-fig fig-term" aria-hidden="true">
            <span class="ln"><i>&gt;</i> /permissions</span>
            <span class="ln dim">  Modo actual: auto</span>
            <span class="ln"><i>&gt;</i> !git status<b class="cur"></b></span>
          </div>
          <h3>Practicas en el navegador</h3>
          <p>Simuladores de terminal, generadores de configuración y quizzes con explicación, sin instalar nada.</p>
        </div>
        <div class="how-item">
          <div class="how-fig fig-themes" aria-hidden="true">
            <span style="--p:#ecedef;--i:#15161a">Aa<small>Perla</small></span>
            <span style="--p:#efe8dc;--i:#241d14">Aa<small>Arena</small></span>
            <span style="--p:#111216;--i:#ececee">Aa<small>Grafito</small></span>
          </div>
          <h3>Lees a tu manera</h3>
          <p>Tres temas de lectura, tamaño de texto ajustable y tu avance guardado en el navegador, sin cuentas.</p>
        </div>
      </div>
    </section>

    <!-- ================= un fragmento ================= -->
    <section class="excerpt">
      <blockquote>
        <p>
          En un chat tú eres el puente: copias contexto, pegas respuestas y corres comandos. Con un agente, él recorre
          ese puente. Tu trabajo pasa a ser dirigir y verificar.
        </p>
        <footer>De <a href={`/${featured.slug}/basico/`}>{featured.title}</a>, lección 1.1</footer>
      </blockquote>
    </section>
  </main>

  <Colophon note="Sin cuentas ni registros. Tu progreso se guarda en tu navegador." />

  <script is:inline>
    (function () {
      var box = document.querySelector("[data-resume]");
      if (!box) return;
      var best = null;
      JSON.parse(box.dataset.resume).forEach(function (g) {
        var s; try { s = JSON.parse(localStorage.getItem(g.key) || "null"); } catch (e) {}
        if (!s) return;
        var n = Object.keys(s.done || {}).filter(function (k) { return s.done[k]; }).length + Object.keys(s.quiz || {}).filter(function (k) { return s.quiz[k]; }).length;
        var pct = Math.min(100, Math.round((n / g.total) * 100));
        if (pct > 0 && pct < 100 && (!best || pct > best.pct)) best = { slug: g.slug, title: g.title, pct: pct };
      });
      if (!best) return;
      box.querySelector(".resume-card").href = "/" + best.slug + "/";
      box.querySelector(".resume-title").textContent = best.title;
      box.querySelector(".resume-track b").style.width = best.pct + "%";
      box.querySelector(".resume-pct").textContent = best.pct + " % leído";
      box.hidden = false;
    })();
  </script>
</Base>

<style>
  main > section {
    max-width: 1104px;
    margin: 0 auto;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: 500 13px var(--sans);
    color: var(--ink-2);
    padding: 7px 12px 7px 10px;
    border: 1px solid var(--rule-2);
    border-radius: 999px;
  }
  .pill i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 10px var(--signal);
  }
  .pill.dark {
    color: #a8abb4;
    border-color: rgb(255 255 255 / 0.14);
    padding: 5px 10px 5px 8px;
    font-size: 12px;
  }

  /* ---------- hero ---------- */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 48px;
    align-items: center;
    padding: 64px 0 88px;
  }
  .hero-copy h1 {
    margin: 22px 0 0;
  }
  .subtitle {
    color: var(--ink-2);
    max-width: 30em;
    margin: 26px 0 30px;
  }
  .cta {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  /* la ruta de la guía, como una pista de circuito con sus cuatro niveles */
  .route {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 22px 18px;
    border-radius: 20px;
    text-decoration: none;
    color: #ececee;
    background-color: #111216;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.2px);
    background-size: 18px 18px;
    border: 1px solid #23252c;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
    transition: transform 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .route:hover {
    transform: translateY(-4px);
    box-shadow: 0 36px 66px -30px rgb(0 0 0 / 0.65), 0 0 50px -22px var(--signal);
  }
  .route-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .route-head b {
    font: 900 30px/1 var(--display);
    font-stretch: 75%;
  }
  .route svg {
    width: 100%;
    height: auto;
  }
  .route .trace {
    fill: none;
    stroke: rgb(255 255 255 / 0.14);
    stroke-width: 3;
    stroke-linejoin: round;
  }
  .route .trace.lit {
    stroke: var(--signal);
    stroke-dasharray: 900;
    stroke-dashoffset: 900;
    filter: drop-shadow(0 0 6px var(--signal));
    animation: route-draw 3.6s ease-in-out infinite;
  }
  @keyframes route-draw {
    0% { stroke-dashoffset: 900; opacity: 1; }
    80% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  .route .pad {
    fill: #111216;
    stroke: rgb(255 255 255 / 0.25);
    stroke-width: 2.5;
  }
  .route .core {
    fill: rgb(255 255 255 / 0.25);
    animation: route-core 3.6s ease-in-out infinite;
    animation-delay: var(--d);
  }
  @keyframes route-core {
    0%, 8% { fill: rgb(255 255 255 / 0.25); }
    14%, 70% { fill: var(--signal); filter: drop-shadow(0 0 6px var(--signal)); }
    100% { fill: rgb(255 255 255 / 0.25); }
  }
  .route .n {
    fill: #ececee;
    font: 800 19px var(--display);
    font-stretch: 85%;
  }
  .route .d {
    fill: #8b8f99;
    font: 500 12px var(--sans);
  }
  @media (max-width: 760px) {
    .route .n { font-size: 24px; }
    .route .d { font-size: 16px; }
  }
  .route .sig {
    fill: #fff;
    filter: drop-shadow(0 0 8px var(--signal)) drop-shadow(0 0 3px var(--signal));
  }
  .route-foot {
    font: 500 13px var(--sans);
    color: #7a7e89;
  }

  /* ---------- seguir leyendo ---------- */
  .resume {
    margin-top: -40px !important;
    padding-bottom: 72px;
  }
  .resume-label {
    display: block;
    font: 600 13px var(--sans);
    color: var(--ink-3);
    margin-bottom: 10px;
  }
  .resume-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 20px;
    align-items: center;
    padding: 18px 22px;
    border-radius: 14px;
    border: 1px solid var(--rule);
    background: var(--surface);
    box-shadow: var(--shadow);
    color: var(--ink);
    text-decoration: none;
  }
  .resume-title {
    font: 900 24px var(--display);
    font-stretch: 78%;
  }
  .resume-track {
    height: 4px;
    border-radius: 4px;
    background: var(--rule);
    overflow: hidden;
  }
  .resume-track b {
    display: block;
    height: 100%;
    background: var(--signal);
    box-shadow: 0 0 10px var(--signal);
  }
  .resume-pct {
    font: 500 14px var(--sans);
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }

  /* ---------- encabezados de sección ---------- */
  .sec-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 36px;
  }
  .sec-head p {
    margin: 0;
    font-size: 16px;
    color: var(--ink-2);
  }

  /* ---------- biblioteca ---------- */
  .library {
    padding-bottom: 104px;
  }
  .boards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
  }
  .board-sum {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 14px 4px 0;
  }

  /* ---------- cómo son ---------- */
  .how {
    padding-bottom: 104px;
  }
  .how-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .how-item h3 {
    font-size: 26px;
    line-height: 1.05;
    font-weight: 800;
    font-stretch: 80%;
    margin: 22px 0 8px;
  }
  .how-item p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
  .how-fig {
    height: 150px;
    border-radius: 16px;
    padding: 20px;
    position: relative;
    overflow: hidden;
    background-color: #111216;
    background-image: radial-gradient(rgb(255 255 255 / 0.07) 1px, transparent 1.2px);
    background-size: 18px 18px;
    border: 1px solid #23252c;
    color: #ececee;
  }
  .fig-anim {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }
  .fa-row {
    display: flex;
    gap: 4px;
    height: 30px;
  }
  .fa-row i {
    flex: 1;
    border-radius: 6px;
  }
  .fa-row i:first-child {
    flex: 2.4;
  }
  .fa-row .r {
    background: #5fd69a;
    box-shadow: 0 0 16px -4px #5fd69a;
  }
  .fa-row .w {
    background: var(--signal);
    box-shadow: 0 0 16px -4px var(--signal);
  }
  .fa-row.cache i {
    background: rgb(95 214 154 / 0.16);
    box-shadow: inset 0 0 0 1.5px rgb(95 214 154 / 0.55);
  }
  .fa-beam {
    position: absolute;
    top: 20px;
    bottom: 20px;
    left: 20px;
    width: 2px;
    background: #5fd69a;
    box-shadow: 0 0 14px #5fd69a;
    animation: fa-scan 2.8s ease-in-out infinite;
  }
  @keyframes fa-scan {
    0% { transform: translateX(0); opacity: 0; }
    15% { opacity: 1; }
    70% { transform: translateX(calc(var(--w, 260px) * 0.72)); opacity: 1; }
    100% { transform: translateX(calc(var(--w, 260px) * 0.72)); opacity: 0; }
  }
  .fig-themes {
    display: flex;
    gap: 12px;
    align-items: center;
    justify-content: center;
  }
  .fig-themes > span {
    width: 74px;
    height: 100px;
    border-radius: 10px;
    background: var(--p);
    color: var(--i);
    border: 1px solid rgb(255 255 255 / 0.14);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font: 900 28px var(--display);
    font-stretch: 80%;
  }
  .fig-themes small {
    font: 500 11px var(--sans);
    opacity: 0.75;
  }
  .fig-term {
    font: 13.5px/1.9 var(--mono);
    display: flex;
    flex-direction: column;
    justify-content: center;
    white-space: pre;
  }
  .fig-term i {
    font-style: normal;
    color: var(--signal);
  }
  .fig-term .dim {
    color: #7a7e89;
  }
  .fig-term .cur {
    display: inline-block;
    width: 8px;
    height: 15px;
    margin-left: 4px;
    vertical-align: -2px;
    background: var(--signal);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- fragmento ---------- */
  .excerpt {
    padding: 8px 0 112px;
  }
  .excerpt blockquote {
    margin: 0 auto;
    max-width: 30em;
    text-align: center;
  }
  .excerpt blockquote::before {
    content: "“";
    display: block;
    font: 900 110px/0.6 var(--display);
    color: var(--signal);
    margin-bottom: 18px;
  }
  .excerpt footer {
    font: 500 14px var(--sans);
    color: var(--ink-3);
    margin-top: 22px;
  }

  @media (max-width: 1180px) {
    main > section {
      margin: 0 28px;
    }
  }
  @media (max-width: 960px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      padding: 44px 0 72px;
    }
    .boards,
    .how-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    main > section {
      margin: 0 18px;
    }
    .resume-card {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .resume-track {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .route .trace.lit,
    .route .core,
    .fa-beam {
      animation: none;
    }
    .route .trace.lit {
      stroke-dashoffset: 0;
    }
    .route .sig {
      display: none;
    }
  }
</style>
